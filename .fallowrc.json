{
  "entry": [
    "src/context/processor.ts",
    "src/context/repo-worker.ts",
    "src/models/decision-worker.ts",
    "src/runner/transition-indexes-worker.ts",
    // Threads and processes started by URL string or spawned by tests, not imported.
    "src/audit/fallow-thread.ts",
    "src/audit/wasm/*-probe.ts",
    "src/streams/reader-worker.ts",
    "src/trajectory/effort-worker.ts",
    "src/streams/test-flipper.ts",
    // Command-line tools run by hand with `bun scripts/<name>.ts`, and the website's own.
    "scripts/*.ts",
    "website/scripts/*.ts",
    "website/test/e2e/*.mjs",
    // The demo page's module entry, loaded by its HTML.
    "website/demo/src/main.tsx",
    // Browser bundle entries that the DOM tests build with Bun.build and load into happy-dom.
    "test/**/dom-entry.tsx",
    "website/demo/test/entry.ts",
    "src/**/*.fixture.ts",
    "src/**/cli.ts",
    "test/**/*.fixture.ts",
    "test/**/*-probe.ts",
    "test/budget-widget/visual.ts"
  ],
  "ignorePatterns": [
    "design/**",
    ".cache/**",
    ".claude/**",
    "contributions/**",
    "vendor/**",
    "crates/**",
    ".agents/**",
    "dist/**",
    "website/public/**",
    "test/fixtures/profile/**"
  ],
  "duplicates": {
    // Clones of at least 100 tokens (about 8 lines) are findings; shorter repeats are the
    // idiomatic boilerplate of schemas, SQL and JSX that a helper would only rename.
    "minTokens": 100,
    "minLines": 5,
    "ignore": [
      // Tests and fixtures repeat their setup on purpose so each case reads on its own.
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.fixture.ts",
      "**/*.fixtures.ts",
      "test/**",
      // The website is its own package and cannot import `src/webgpu/speech.ts`; it mirrors the
      // function and `website/test/live-segments.test.ts` keeps the two in agreement.
      "website/src/live/segments.ts",
      // `prepareVerificationCandidate` and `prepareProfileFix` are two preparation paths whose
      // replay checks differ in the recorded journal they read and in the profile they run with;
      // the shared-looking lines guard the same stored receipts, and one helper over both would
      // put two paths of the recovery state machine behind a shared branch.
      "src/runner/verification-candidate.ts"
    ]
  },
  "rules": {
    "unused-class-members": "off"
  },
  // Imported by production code, but the build bundles them into dist/, so the installed package
  // needs none of them at runtime; they stay devDependencies on purpose.
  "ignoreDependencies": ["solid-js", "typegpu", "vite-plugin-solid"],
  "ignoreExports": [
    // Each demo panel module exposes the same names (`mount`, `rpc`, `reads`, ...) because the
    // demo shell loads them through one interface; the names are the contract, not a collision.
    {
      "file": "website/demo/src/panels/*.ts",
      "exports": ["mount", "rpc", "reads", "PROJECT", "DemoCall", "DemoModel"]
    },
    // The website is its own package and cannot import `src/webgpu/speech.ts`; it mirrors the
    // function and `website/test/live-segments.test.ts` keeps the two in agreement.
    {
      "file": "website/src/live/segments.ts",
      "exports": ["speechSegments"]
    },
    {
      "file": "src/runner/architect-contact-rpc.ts",
      "exports": ["ArchitectContact"]
    }
  ]
}
