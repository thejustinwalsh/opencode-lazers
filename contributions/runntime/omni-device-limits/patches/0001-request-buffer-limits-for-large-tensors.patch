From 625c05e0834753302aef41a122e7121f6c6e3276 Mon Sep 17 00:00:00 2001
From: Justin Walsh <contact.me@thejustinwalsh.com>
Date: Fri, 20 Nov 2026 04:42:35 -0500
Subject: [PATCH] fix(core): request buffer limits so tensors past 128 MiB are
 not refused on capable adapters

(cherry picked from commit 22564dff94e530561752b57104b919b93813eedc)
---
 packages/runntime/src/core/gpu/buffers.ts     |  3 +-
 packages/runntime/src/core/gpu/limits.ts      | 39 +++++++++++++++++++
 packages/runntime/src/core/index.ts           |  1 +
 .../runntime/src/zoo/transformers/init.ts     | 10 +++--
 .../runntime/test/core/gpu/limits.test.ts     | 35 +++++++++++++++++
 5 files changed, 84 insertions(+), 4 deletions(-)
 create mode 100644 packages/runntime/src/core/gpu/limits.ts
