   RUNNTIME_ERROR_CODES,
diff --git a/packages/runntime/src/zoo/transformers/init.ts b/packages/runntime/src/zoo/transformers/init.ts
index b577f6e..dd6572a 100644
--- a/packages/runntime/src/zoo/transformers/init.ts
+++ b/packages/runntime/src/zoo/transformers/init.ts
@@ -1,19 +1,23 @@
 import tgpu from 'typegpu';
 import type { TgpuRoot } from 'typegpu';
-import { initRunntime } from '../../core/index.ts';
+import { bufferLimits, initRunntime } from '../../core/index.ts';
 import { registerRunntimeBackend, type RegisterRunntimeBackendOpts } from './registry.ts';
 
 /** One-call plugin setup: creates the WebGPU device, runs the models on it
  *  and patches transformers.js. Requests `subgroups`, which makes matmul and
  *  attention faster, and `shader-f16`, which the YOLO26 and DepthART models
  *  need and the others use when present. A device without them still loads
- *  every model that runs in f32. Options go straight to
+ *  every model that runs in f32. Also requests the adapter's buffer limits,
+ *  since the WebGPU defaults refuse a tensor past 128 MiB. Options go straight to
  *  registerRunntimeBackend(), so `models` and `fallbackToOnnx` work here too.
  *  Returns the root for apps that also use TypeGPU directly. */
 export async function initRunntimeBackend(
   opts: RegisterRunntimeBackendOpts = {},
 ): Promise<TgpuRoot> {
-  const root = await tgpu.init({ device: { optionalFeatures: ['subgroups', 'shader-f16'] } });
+  const requiredLimits = await bufferLimits();
+  const root = await tgpu.init({
+    device: { optionalFeatures: ['subgroups', 'shader-f16'], requiredLimits },
+  });
   initRunntime(root);
   registerRunntimeBackend(opts);
   return root;
diff --git a/packages/runntime/test/core/gpu/limits.test.ts b/packages/runntime/test/core/gpu/limits.test.ts
new file mode 100644
index 0000000..2507191
--- /dev/null
+++ b/packages/runntime/test/core/gpu/limits.test.ts
@@ -0,0 +1,35 @@
+import { describe, expect, it } from 'vitest';
+import { bufferLimits } from '../../../src/core/gpu/limits.ts';
+
+const adapterLimits = { maxStorageBufferBindingSize: 4_294_967_292, maxBufferSize: 4_294_967_296 };
+const gpu = { requestAdapter: async () => ({ limits: adapterLimits }) } as unknown as Pick<
+  GPU,
+  'requestAdapter'
+>;
+
+describe('bufferLimits', () => {
+  it("returns the adapter's limits when no size is given", async () => {
+    expect(await bufferLimits(undefined, gpu)).toEqual(adapterLimits);
+  });
+
+  it('returns the requested size between the default and the adapter limit', async () => {
+    expect(await bufferLimits(500_000_000, gpu)).toEqual({
+      maxStorageBufferBindingSize: 500_000_000,
+      maxBufferSize: 500_000_000,
+    });
+  });
+
+  it('never goes below the WebGPU defaults or above the adapter', async () => {
+    expect(await bufferLimits(1, gpu)).toEqual({
+      maxStorageBufferBindingSize: 134_217_728,
+      maxBufferSize: 268_435_456,
+    });
+    expect(await bufferLimits(2 ** 40, gpu)).toEqual(adapterLimits);
+  });
+
+  it('returns undefined with no adapter', async () => {
+    const none = { requestAdapter: async () => null } as unknown as Pick<GPU, 'requestAdapter'>;
+    expect(await bufferLimits(undefined, none)).toBeUndefined();
+    expect(await bufferLimits(undefined, undefined)).toBeUndefined();
+  });
+});
