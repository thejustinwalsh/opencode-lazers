From c5f288c17b23b295615e87919d8caaa709e12037 Mon Sep 17 00:00:00 2001
From: lazers-worker <lazers-worker@local>
Date: Sat, 14 Nov 2026 06:39:20 -0500
Subject: [PATCH 4/4] refactor(zoo): fuse LFM3 logits readback into the eval
 submit

Request the logits (and hidden, when needed) through readbackManyOnSubmit
before the single eval so one submit and one batched map replace one
submit plus separate readbacks. Cache targets ride the same eval and stay
materialized; submit failures reject the pending copy via the shared
ReadbackQueue, and uploads plus step values retain their existing
release paths.
---
 packages/runntime/src/zoo/tasks/nlp/lfm3.ts | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/packages/runntime/src/zoo/tasks/nlp/lfm3.ts b/packages/runntime/src/zoo/tasks/nlp/lfm3.ts
index 0c69573..02fd1c5 100644
--- a/packages/runntime/src/zoo/tasks/nlp/lfm3.ts
+++ b/packages/runntime/src/zoo/tasks/nlp/lfm3.ts
@@ -9,7 +9,6 @@ import {
   inGpuErrorScopes,
   isRunntimeError,
   RunntimeError,
-  toArray,
   warmUp,
   type RangeSource,
   type RunntimeExecutor,
@@ -115,13 +114,22 @@ export async function loadLfm3Backbone(
       const result = await inGpuErrorScopes(root.device, 'LFM3 generation', async () => {
         const current = create(uploads);
         step = current;
+        // Fuse the logits (and hidden, when requested) readback into the eval's
+        // own submit: one submit and one batched map round-trip instead of one
+        // submit plus separate readbacks. Cache targets ride the same eval so
+        // they stay materialized; a submit failure rejects the pending copy
+        // through the shared ReadbackQueue.
+        const pending = executor.readbackManyOnSubmit(
+          readHidden ? [current.logits, current.hidden] : [current.logits],
+        );
+        pending.catch(() => undefined);
         evalValues(
           [current.logits, ...(readHidden ? [current.hidden] : []), ...cacheValues(current.cache)],
           executor,
         );
-        const logitsPromise = toArray(current.logits, executor);
-        const hiddenPromise = readHidden ? toArray(current.hidden, executor) : undefined;
-        const [logits, hidden] = await Promise.all([logitsPromise, hiddenPromise]);
+        const outs = await pending;
+        const logits = outs[0]!;
+        const hidden = outs[1];
         await releaseAfterWork();
         if (signal.aborted) {
           throw new RunntimeError('EXECUTION_FAILED', 'LFM3 generation aborted', {
