From 51a86bff608d0d98d80eea3d2ac72795d28cf337 Mon Sep 17 00:00:00 2001
From: lazers-worker <lazers-worker@local>
Date: Sat, 14 Nov 2026 06:39:12 -0500
Subject: [PATCH 3/7] refactor(core): move depthwise padLeft to the dimensions
 uniform

Keep the depthwise pipeline keyed only on channels and kernel size so
the decode cache fill no longer creates a pipeline variant per padLeft.
padLeft rides the per-dispatch dimensions uniform with identical values
and boundaries; D1 asymmetric handling is untouched.
---
 .../runntime/src/core/gpu/dispatch/conv.ts    |  5 ++---
 .../src/core/kernels/conv/depthwiseConv1d.ts  | 20 +++++++++++--------
 2 files changed, 14 insertions(+), 11 deletions(-)

diff --git a/packages/runntime/src/core/gpu/dispatch/conv.ts b/packages/runntime/src/core/gpu/dispatch/conv.ts
index 1838b53..f4ac383 100644
--- a/packages/runntime/src/core/gpu/dispatch/conv.ts
+++ b/packages/runntime/src/core/gpu/dispatch/conv.ts
@@ -143,17 +143,16 @@ export const depthwiseConv1dSpec = defineSpec({
   cfg: (node, attrs) => ({
     channels: node.pending!.inputs[0]!.shape.dims![1]!,
     kernel: attrs.kernel,
-    padLeft: attrs.padLeft,
   }),
   pipeline: (root, dtype, cfg) => createDepthwiseConv1dPipeline(root, cfg, elemFor(dtype)),
-  encode: ({ node, pipeline, inputs, out, ctx }) => {
+  encode: ({ node, attrs, pipeline, inputs, out, ctx }) => {
     const [rowsIn] = node.pending!.inputs[0]!.shape.dims as [number, number];
     const [rowsOut, channels] = node.shape.dims as [number, number];
     return [
       depthwiseConv1dHandle(
         ctx.root,
         pipeline,
-        { rowsIn, rowsOut, channels },
+        { rowsIn, rowsOut, channels, padLeft: attrs.padLeft },
         {
           x: narrowFloat(inputs[0]!, node.shape.dtype),
           w: narrowFloat(inputs[1]!, node.shape.dtype),
