From 52bfe741cb1036d39206150aa198c8ed3cb6d605 Mon Sep 17 00:00:00 2001
From: lazers-worker <lazers-worker@local>
Date: Sat, 14 Nov 2026 07:30:20 -0500
Subject: [PATCH 6/6] test(zoo): regress fused-readback recovery and
 stream-only rejection

Give the lifecycle upload-ownership test a valid [1, 2048] embedding so
the injected synchronous graph failure is actually reached. Add a
same-session failure-then-success generation, a stream-only early-break
case proving the internal result observer holds a late rejection, and a
toArrayFused failure-then-success case proving a rejected pending
readback does not poison the next request.
---
 .../lfm3/fused-readback-recovery.gpu.test.ts  | 31 ++++++++
 .../test/zoo/lfm3/model-lifecycle.gpu.test.ts |  4 +-
 .../runntime/test/zoo/lfm3/session.test.ts    | 73 +++++++++++++++++++
 3 files changed, 106 insertions(+), 2 deletions(-)
 create mode 100644 packages/runntime/test/zoo/lfm3/fused-readback-recovery.gpu.test.ts

diff --git a/packages/runntime/test/zoo/lfm3/fused-readback-recovery.gpu.test.ts b/packages/runntime/test/zoo/lfm3/fused-readback-recovery.gpu.test.ts
new file mode 100644
index 0000000..a695ad0
--- /dev/null
+++ b/packages/runntime/test/zoo/lfm3/fused-readback-recovery.gpu.test.ts
@@ -0,0 +1,31 @@
+/** The retained separate-submit readback path recovers after an eval failure.
+ *
+ *  runStep queues no fused readback before its eval: when graph collection,
+ *  allocation or dispatch throws pre-submit, no shared ReadbackQueue entry is
+ *  left behind to poison the next request with 'a readback is already
+ *  queued'. toArrayFused is the only fused entry point kept, and it rejects
+ *  its own pending readback when its eval fails. This locks both halves. */
+
+import { expect, it } from 'vitest';
+import { tensor } from '../../../src/core/gpu/buffers.ts';
+import { matrix } from '../../../src/core/graph/value.ts';
+import { toArray } from '../../../src/core/gpu/eval.ts';
+import { gpu } from '../../gpu.ts';
+
+it('toArrayFused rejects its pending readback and the next readback proceeds', async () => {
+  const { root, ex } = await gpu();
+  const good = tensor(root, new Float32Array([1, 2, 3, 4]), matrix(2, 2));
+  try {
+    // A released target makes the fused eval throw before any submit.
+    const released = tensor(root, new Float32Array([5, 6, 7, 8]), matrix(2, 2));
+    ex.releaseValues([released]);
+    await expect(toArray(released, ex)).rejects.toThrow(/evalValues/);
+    // The queue is clean: the next fused readback is not poisoned.
+    await expect(toArray(good, ex)).resolves.toEqual(new Float32Array([1, 2, 3, 4]));
+  } finally {
+    if (good.state === 'materialized') good.buffer.destroy();
+  }
+  // The shared staging lease and memoized dims uniform persist per root by
+  // design; the assertion above (second readback resolves) proves the queue
+  // itself was cleared.
+});
diff --git a/packages/runntime/test/zoo/lfm3/model-lifecycle.gpu.test.ts b/packages/runntime/test/zoo/lfm3/model-lifecycle.gpu.test.ts
