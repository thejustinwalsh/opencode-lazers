+        <div class="stats"><span id="speed">–</span><span>on-device · WebGPU</span></div>
+        <div class="loading" id="loading"><div><span id="loadText">Starting…</span><b><i id="loadBar"></i></b></div></div>
+      </div>
+      <div class="checks">
+        ${CHECKS.map(
+          (c) => `
+          <div class="check" id="c-${c.key}">
