index 0000000..8c4f177
--- /dev/null
+++ b/packages/runntime/src/zoo/d1/image.ts
@@ -0,0 +1,190 @@
+/** d1 image preprocessing on the CPU, ported from the checkpoint's vision.py:
+ *  LFM2-VL's smart resize and tiling, torch's antialiased bilinear resize, and
+ *  16 px patches in SigLIP2 NaFlex order. */
+
+/** Tile side of a large image, px. */
+const TILE = 512;
+/** SigLIP2 patch side, px. */
+export const PATCH = 16;
+/** Side of the 2x2 pixel unshuffle in the projector, in patches. */
+const FACTOR = 32;
+/** Pixel budget of one crop: 64 to 256 projected tokens of 32x32 px. */
+const MAX_PIXELS = 256 * 1024;
+const MIN_PIXELS = 64 * 1024;
+
+/** RGB bytes, row-major HWC. */
+export interface RgbImage {
+  width: number;
+  height: number;
+  data: Uint8Array | Uint8ClampedArray;
+}
+
+/** One crop as patch rows, [ph·pw, 3·16·16] in (py, px, c) order, in [-1, 1]. */
+export interface Crop {
+  ph: number;
+  pw: number;
+  patches: Float32Array;
+}
+
+/** LFM2-VL's smart resize, tile grid and thumbnail size. */
+export function layout(
+  width: number,
+  height: number,
+): { grid: [number, number]; thumbnail: [number, number]; tiled: boolean } {
+  let h = Math.max(FACTOR, Math.round(height / FACTOR) * FACTOR);
+  let w = Math.max(FACTOR, Math.round(width / FACTOR) * FACTOR);
+  if (h * w > MAX_PIXELS) {
+    const beta = Math.sqrt((height * width) / MAX_PIXELS);
+    h = Math.max(FACTOR, Math.floor(height / beta / FACTOR) * FACTOR);
+    w = Math.max(FACTOR, Math.floor(width / beta / FACTOR) * FACTOR);
+  } else if (h * w < MIN_PIXELS) {
+    const beta = Math.sqrt(MIN_PIXELS / (height * width));
+    h = Math.ceil((height * beta) / FACTOR) * FACTOR;
+    w = Math.ceil((width * beta) / FACTOR) * FACTOR;
+  }
+  const tiled =
+    Math.max(16, Math.round(height / FACTOR) * FACTOR) *
+      Math.max(16, Math.round(width / FACTOR) * FACTOR) >
+    MAX_PIXELS * 2;
+  let grid: [number, number] = [1, 1];
+  if (tiled) {
+    const seen = new Set<string>();
+    const ratios: [number, number][] = [];
+    for (let n = 2; n <= 10; n++) {
+      for (let x = 1; x <= n; x++) {
+        for (let y = 1; y <= n; y++) {
+          if (x * y < 2 || x * y > 10 || seen.has(`${x},${y}`)) continue;
+          seen.add(`${x},${y}`);
+          ratios.push([x, y]);
+        }
+      }
+    }
+    // Python sorts the set by area; ties keep set order, which this matches
+    // only up to tie order. The tie rule below prefers the larger grid anyway.
+    ratios.sort((a, b) => a[0] * a[1] - b[0] * b[1]);
+    let best = Infinity;
+    for (const r of ratios) {
+      const diff = Math.abs(width / height - r[0] / r[1]);
+      if (diff < best || (diff === best && width * height > 0.5 * TILE * TILE * r[0] * r[1])) {
+        grid = r;
+        best = diff;
+      }
+    }
+  }
+  return { grid, thumbnail: [h, w], tiled };
+}
+
+/** Per-output-index source taps of torch's antialiased bilinear resize
+ *  (PIL's triangle filter, support widened by the downscale factor). */
+function aaTaps(inSize: number, outSize: number): { start: number; weights: Float64Array }[] {
+  const scale = inSize / outSize;
+  const support = scale >= 1 ? scale : 1;
+  const invScale = scale >= 1 ? 1 / scale : 1;
+  const taps = [];
+  for (let i = 0; i < outSize; i++) {
+    const center = scale * (i + 0.5);
+    const start = Math.max(Math.trunc(center - support + 0.5), 0);
+    const end = Math.min(Math.trunc(center + support + 0.5), inSize);
+    const weights = new Float64Array(end - start);
+    let sum = 0;
+    for (let j = start; j < end; j++) {
+      const w = Math.max(0, 1 - Math.abs((j - center + 0.5) * invScale));
+      weights[j - start] = w;
+      sum += w;
+    }
+    for (let j = 0; j < weights.length; j++) weights[j]! /= sum || 1;
+    taps.push({ start, weights });
+  }
+  return taps;
+}
+
+/** Antialiased bilinear resize of an [h, w, c] float image, separable:
+ *  width first, then height. */
+export function resizeAA(
+  src: Float32Array,
+  h: number,
+  w: number,
+  c: number,
+  outH: number,
+  outW: number,
+): Float32Array {
+  const tx = aaTaps(w, outW);
+  const ty = aaTaps(h, outH);
+  const mid = new Float32Array(h * outW * c);
+  for (let y = 0; y < h; y++) {
+    for (let x = 0; x < outW; x++) {
+      const { start, weights } = tx[x]!;
+      for (let ch = 0; ch < c; ch++) {
+        let acc = 0;
+        for (let k = 0; k < weights.length; k++)
+          acc += weights[k]! * src[(y * w + start + k) * c + ch]!;
+        mid[(y * outW + x) * c + ch] = acc;
+      }
+    }
+  }
+  const out = new Float32Array(outH * outW * c);
+  for (let y = 0; y < outH; y++) {
+    const { start, weights } = ty[y]!;
+    for (let x = 0; x < outW; x++) {
+      for (let ch = 0; ch < c; ch++) {
+        let acc = 0;
+        for (let k = 0; k < weights.length; k++)
+          acc += weights[k]! * mid[((start + k) * outW + x) * c + ch]!;
+        out[(y * outW + x) * c + ch] = acc;
+      }
+    }
+  }
+  return out;
+}
+
+/** Resize to uint8 levels, as torchvision does on a uint8 tensor. */
+function resizeRgb(img: RgbImage, outH: number, outW: number): Float32Array {
+  const out = resizeAA(Float32Array.from(img.data), img.height, img.width, 3, outH, outW);
+  for (let i = 0; i < out.length; i++) out[i] = Math.min(255, Math.max(0, Math.round(out[i]!)));
+  return out;
+}
+
+/** An [h, w, 3] uint8-level crop to normalized patch rows. */
+function patchify(px: Float32Array, h: number, w: number): Crop {
+  const ph = h / PATCH;
+  const pw = w / PATCH;
+  const dim = 3 * PATCH * PATCH;
+  const patches = new Float32Array(ph * pw * dim);
+  for (let py = 0; py < ph; py++) {
+    for (let pxi = 0; pxi < pw; pxi++) {
+      const base = (py * pw + pxi) * dim;
+      for (let y = 0; y < PATCH; y++) {
+        for (let x = 0; x < PATCH; x++) {
+          const s = ((py * PATCH + y) * w + pxi * PATCH + x) * 3;
+          const d = base + (y * PATCH + x) * 3;
+          for (let ch = 0; ch < 3; ch++) patches[d + ch] = (px[s + ch]! - 127.5) / 127.5;
+        }
+      }
+    }
+  }
+  return { ph, pw, patches };
+}
+
+/** An image to its crops: the tiles of a large image, then the thumbnail. */
+export function preprocessImage(img: RgbImage): Crop[] {
+  const plan = layout(img.width, img.height);
+  const crops: Crop[] = [];
+  if (plan.tiled) {
+    const [gw, gh] = plan.grid;
+    const big = resizeRgb(img, gh * TILE, gw * TILE);
+    const bigW = gw * TILE;
+    for (let r = 0; r < gh; r++) {
+      for (let c = 0; c < gw; c++) {
+        const tile = new Float32Array(TILE * TILE * 3);
+        for (let y = 0; y < TILE; y++) {
+          const s = ((r * TILE + y) * bigW + c * TILE) * 3;
+          tile.set(big.subarray(s, s + TILE * 3), y * TILE * 3);
+        }
+        crops.push(patchify(tile, TILE, TILE));
+      }
+    }
+  }
+  const [h, w] = plan.thumbnail;
+  crops.push(patchify(resizeRgb(img, h, w), h, w));
+  return crops;
+}
diff --git a/packages/runntime/src/zoo/d1/model.ts b/packages/runntime/src/zoo/d1/model.ts
new file mode 100644
index 0000000..0ab822e
--- /dev/null
+++ b/packages/runntime/src/zoo/d1/model.ts
@@ -0,0 +1,276 @@
+/** d1-omni-600M on core ops: the bidirectional LFM2 trunk, the decision head
+ *  and the SigLIP2 vision tower with its projector. Audio is not ported.
+ *
+ *  Parameter names follow the checkpoint after stateDictHooks.ts reshapes it:
+ *  RMSNorm weights are `scale`, the MLP's w3 and w1 are row-stacked into
+ *  `w13`, attention q/k rows are permuted so rotate-half RoPE becomes the
+ *  kernel's interleaved pairs, and every softmax scale is folded into q. */
+
+import {
+  add,
+  cat,
+  clamp,
+  gatherRows,
+  mul,
+  nn,
+  reshape,
+  rope,
+  sdpa,
+  sdpaPacked,
+  slice,
+  swigluChunk,
+  tanh,
+  type LazyStateDict,
+  type Value,
+} from '../../core/index.ts';
+import { transformD1StateDict } from './stateDictHooks.ts';
+
+export const D1 = {
+  vocab: 65536,
+  hidden: 1024,
+  ffn: 4608,
+  heads: 16,
+  kvHeads: 8,
+  headDim: 64,
+  eps: 1e-5,
+  ropeTheta: 1e6,
+  layerTypes: 'ccaccaccacacacac',
+  headLayers: 2,
+  headFfn: 4096,
+  visionHidden: 768,
+  visionFfn: 3072,
+  visionHeads: 12,
+  visionLayers: 12,
+  visionEps: 1e-6,
+  /** SigLIP2's position grid side; resized to each crop's patch grid. */
+  posGrid: 16,
+  projectorHidden: 2048,
+} as const;
+
+class ShortConv extends nn.Module<[Value, Value, Value | undefined, Value], Value> {
+  readonly in_proj = new nn.Linear(D1.hidden, 3 * D1.hidden, { bias: false });
+  readonly out_proj = new nn.Linear(D1.hidden, D1.hidden, { bias: false });
+  /** The depthwise kernel's three taps, [hidden] each: t−1, t, t+1. */
+  readonly tap0 = new nn.Parameter({ elems: D1.hidden, dtype: 'f32', dims: [D1.hidden] });
+  readonly tap1 = new nn.Parameter({ elems: D1.hidden, dtype: 'f32', dims: [D1.hidden] });
+  readonly tap2 = new nn.Parameter({ elems: D1.hidden, dtype: 'f32', dims: [D1.hidden] });
+
+  /** out(C · conv(B · x)) with a centred 3-tap conv; `keepRight` [T,1] zeroes
+   *  the t+1 tap on the last media row so media never reads the text. */
+  override forward(x: Value, residual: Value, keepRight: Value | undefined, zeroRow: Value): Value {
+    const t = x.shape.dims![0]!;
+    const bcx = this.in_proj.forward(x);
+    const b = slice(bcx, 1, 0, D1.hidden);
+    const c = slice(bcx, 1, D1.hidden, 2 * D1.hidden);
+    const u = slice(bcx, 1, 2 * D1.hidden, 3 * D1.hidden);
+    const bx = mul(b, u);
+    const prev = cat([zeroRow, slice(bx, 0, 0, t - 1)], 0);
+    let next = cat([slice(bx, 0, 1, t), zeroRow], 0);
+    if (keepRight) next = mul(next, keepRight);
+    const y = add(
+      add(mul(prev, this.tap0.value), mul(bx, this.tap1.value)),
+      mul(next, this.tap2.value),
+    );
+    return this.out_proj.forward(mul(c, y), { addend: residual });
+  }
+}
+
+class TrunkAttention extends nn.Module<[Value, Value, Value, Value, Value | undefined], Value> {
+  readonly q_proj = new nn.Linear(D1.hidden, D1.heads * D1.headDim, { bias: false });
+  readonly k_proj = new nn.Linear(D1.hidden, D1.kvHeads * D1.headDim, { bias: false });
+  readonly v_proj = new nn.Linear(D1.hidden, D1.kvHeads * D1.headDim, { bias: false });
+  readonly out_proj = new nn.Linear(D1.heads * D1.headDim, D1.hidden, { bias: false });
+  readonly q_layernorm = new nn.RMSNorm(D1.headDim, D1.eps);
+  readonly k_layernorm = new nn.RMSNorm(D1.headDim, D1.eps);
+
+  override forward(x: Value, residual: Value, cos: Value, sin: Value, segments?: Value): Value {
+    const t = x.shape.dims![0]!;
+    const perHead = (v: Value, heads: number, norm: nn.RMSNorm) =>
+      reshape(norm.forward(reshape(v, [t * heads, D1.headDim])), [t, heads * D1.headDim]);
+    const q = perHead(this.q_proj.forward(x), D1.heads, this.q_layernorm);
+    const k = perHead(this.k_proj.forward(x), D1.kvHeads, this.k_layernorm);
+    const a = sdpa(
+      rope(q, cos, sin, { headDim: D1.headDim }),
+      rope(k, cos, sin, { headDim: D1.headDim }),
+      this.v_proj.forward(x),
+      {
+        qHeads: D1.heads,
+        kvHeads: D1.kvHeads,
+        headDim: D1.headDim,
+        windowLeft: Infinity,
+        windowRight: Infinity,
+        segments,
+      },
+    );
+    return this.out_proj.forward(a, { addend: residual });
+  }
+}
+
+class SwiGlu extends nn.Module {
+  /** w3 rows then w1 rows: swigluChunk reads hidden first, gate second. */
+  readonly w13 = new nn.Linear(D1.hidden, 2 * D1.ffn, { bias: false });
+  readonly w2 = new nn.Linear(D1.ffn, D1.hidden, { bias: false });
+  forward(x: Value, residual?: Value): Value {
+    return this.w2.forward(swigluChunk(this.w13.forward(x)), { addend: residual });
+  }
+}
+
+class TrunkLayer extends nn.Module {
+  readonly operator_norm = new nn.RMSNorm(D1.hidden, D1.eps);
+  readonly ffn_norm = new nn.RMSNorm(D1.hidden, D1.eps);
+  readonly feed_forward = new SwiGlu();
+  readonly conv?: ShortConv;
+  readonly self_attn?: TrunkAttention;
+  constructor(attention: boolean) {
+    super();
+    if (attention) this.self_attn = new TrunkAttention();
+    else this.conv = new ShortConv();
+  }
+}
+
+/** Per-call trunk inputs: rope tables, the attention key ranges and the conv
+ *  mask that keep the media prefix blind to the text, and a zero row. */
+export interface TrunkInputs {
+  cos: Value;
+  sin: Value;
+  segments?: Value;
+  keepRight?: Value;
+  zeroRow: Value;
+}
+
+export class Trunk extends nn.Module<[Value, TrunkInputs], Value> {
+  readonly embed_tokens = new nn.Embedding(D1.vocab, D1.hidden, { device: 'cpu' });
+  readonly layers = new nn.ModuleList(
+    [...D1.layerTypes].map((kind) => new TrunkLayer(kind === 'a')),
+  );
+  readonly embedding_norm = new nn.RMSNorm(D1.hidden, D1.eps);
+
+  /** Embeddings [T, hidden] (media prefix first) to hidden states. */
+  forward(h: Value, inp: TrunkInputs): Value {
+    for (const layer of this.layers.items) {
+      const x = layer.operator_norm.forward(h);
+      h = layer.self_attn
+        ? layer.self_attn.forward(x, h, inp.cos, inp.sin, inp.segments)
+        : layer.conv!.forward(x, h, inp.keepRight, inp.zeroRow);
+      h = layer.feed_forward.forward(layer.ffn_norm.forward(h), h);
+    }
+    return this.embedding_norm.forward(h);
+  }
+}
+
+/** One nn.TransformerEncoderLayer (norm_first, ReLU) over [L, hidden]. */
+class HeadLayer extends nn.Module {
+  /** Packed q‖k‖v, q pre-scaled by 1/√headDim. */
+  readonly in_proj = new nn.Linear(D1.hidden, 3 * D1.hidden);
+  readonly out_proj = new nn.Linear(D1.hidden, D1.hidden);
+  readonly linear1 = new nn.Linear(D1.hidden, D1.headFfn, { activation: 'relu' });
+  readonly linear2 = new nn.Linear(D1.headFfn, D1.hidden);
+  readonly norm1 = new nn.LayerNorm(D1.hidden, 1e-5, { bias: true });
+  readonly norm2 = new nn.LayerNorm(D1.hidden, 1e-5, { bias: true });
+
+  forward(h: Value): Value {
+    const heads = D1.hidden / 64;
+    const a = sdpaPacked(this.in_proj.forward(this.norm1.forward(h)), {
+      qHeads: heads,
+      kvHeads: heads,
+      headDim: 64,
+      windowLeft: Infinity,
+      windowRight: Infinity,
+    });
+    h = this.out_proj.forward(a, { addend: h });
+    return this.linear2.forward(this.linear1.forward(this.norm2.forward(h)), { addend: h });
+  }
+}
+
+export class DecisionHead extends nn.Module<[Value, Value, readonly number[]], Value> {
+  readonly type_emb = new nn.Embedding(3, D1.hidden, { device: 'cpu' });
+  readonly layers = new nn.ModuleList(Array.from({ length: D1.headLayers }, () => new HeadLayer()));
+  readonly scorer_norm = new nn.LayerNorm(D1.hidden, 1e-5, { bias: true });
+  readonly scorer_fc = new nn.Linear(D1.hidden, D1.hidden, { activation: 'gelu' });
+  readonly scorer_out = new nn.Linear(D1.hidden, 1);
+
+  /** Text hidden states [L, hidden] and the question-type row [1, hidden] to
+   *  one logit per marker, [markers, 1]. */
+  override forward(text: Value, typeRow: Value, markers: readonly number[]): Value {
+    let h = add(text, typeRow);
+    for (const layer of this.layers.items) h = layer.forward(h);
+    const g = gatherRows(h, markers);
+    return this.scorer_out.forward(this.scorer_fc.forward(this.scorer_norm.forward(g)));
+  }
+}
+
+/** gelu_pytorch_tanh: 0.5·x·(1 + tanh(√(2/π)·(x + 0.044715·x³))). */
+function geluTanh(x: Value): Value {
+  const inner = mul(mul(x, add(mul(mul(x, x), 0.044715), 1)), Math.sqrt(2 / Math.PI));
+  return mul(mul(x, add(tanh(clamp(inner, -10, 10)), 1)), 0.5);
+}
+
+class VisionLayer extends nn.Module {
+  readonly layer_norm1 = new nn.LayerNorm(D1.visionHidden, D1.visionEps, { bias: true });
+  readonly layer_norm2 = new nn.LayerNorm(D1.visionHidden, D1.visionEps, { bias: true });
+  /** Packed q‖k‖v, q pre-scaled by 1/√headDim. */
+  readonly qkv = new nn.Linear(D1.visionHidden, 3 * D1.visionHidden);
+  readonly out_proj = new nn.Linear(D1.visionHidden, D1.visionHidden);
+  readonly fc1 = new nn.Linear(D1.visionHidden, D1.visionFfn);
+  readonly fc2 = new nn.Linear(D1.visionFfn, D1.visionHidden);
+
+  forward(x: Value): Value {
+    const a = sdpaPacked(this.qkv.forward(this.layer_norm1.forward(x)), {
+      qHeads: D1.visionHeads,
+      kvHeads: D1.visionHeads,
+      headDim: 64,
+      windowLeft: Infinity,
+      windowRight: Infinity,
+    });
+    x = this.out_proj.forward(a, { addend: x });
+    return this.fc2.forward(geluTanh(this.fc1.forward(this.layer_norm2.forward(x))), { addend: x });
+  }
+}
+
+export class Vision extends nn.Module<[Value, Value, number, number], Value> {
+  readonly patch_embedding = new nn.Linear(3 * 16 * 16, D1.visionHidden);
+  /** [16·16, 768], resized on the CPU to each crop's patch grid. */
+  readonly position_embedding = new nn.CpuParameter({
+    elems: D1.posGrid * D1.posGrid * D1.visionHidden,
+    dtype: 'f32',
+    dims: [D1.posGrid * D1.posGrid, D1.visionHidden],
+  });
+  readonly layers = new nn.ModuleList(
+    Array.from({ length: D1.visionLayers }, () => new VisionLayer()),
+  );
+  readonly post_layernorm = new nn.LayerNorm(D1.visionHidden, D1.visionEps, { bias: true });
+  readonly linear_1 = new nn.Linear(4 * D1.visionHidden, D1.projectorHidden, {
+    activation: 'gelu',
+  });
+  readonly linear_2 = new nn.Linear(D1.projectorHidden, D1.hidden);
+
+  /** One crop's patches [ph·pw, 768] and resized positions to its prefix
+   *  embeddings [(ph/2)·(pw/2), hidden]. */
+  override forward(patches: Value, positions: Value, ph: number, pw: number): Value {
+    let x = this.patch_embedding.forward(patches, { addend: positions });
+    for (const layer of this.layers.items) x = layer.forward(x);
+    x = this.post_layernorm.forward(x);
+    // 2x2 pixel unshuffle: token (i, j) is patches (2i+m, 2j+k) side by side,
+    // in (m, k) order.
+    const quads = [0, 1].flatMap((m) =>
+      [0, 1].map((k) => {
+        const idx: number[] = [];
+        for (let i = 0; i < ph / 2; i++) {
+          for (let j = 0; j < pw / 2; j++) idx.push((2 * i + m) * pw + 2 * j + k);
+        }
+        return gatherRows(x, idx);
+      }),
+    );
+    return this.linear_2.forward(this.linear_1.forward(cat(quads, 1)));
+  }
+}
+
+export class D1Model extends nn.Module {
+  readonly encoder = new Trunk();
+  readonly head = new DecisionHead();
+  readonly vision = new Vision();
+
+  override transformStateDict(sd: LazyStateDict): void {
+    transformD1StateDict(sd);
+  }
+}
diff --git a/packages/runntime/src/zoo/d1/prompt.ts b/packages/runntime/src/zoo/d1/prompt.ts
new file mode 100644
index 0000000..5907487
--- /dev/null
+++ b/packages/runntime/src/zoo/d1/prompt.ts
@@ -0,0 +1,133 @@
+/** d1 questions to token sequences and probabilities back to answers, ported
+ *  from the checkpoint's prompt.py. One question over one state renders as
+ *
+ *      <bos> <state> state <q> instructions <opt> <mask> option_0 </opt> … <decide>
+ *
+ *  and the head scores the hidden state at each `<mask>`. */
+
+import { RunntimeError } from '../../core/error.ts';
+
+/** Question type to the head's type-embedding row. */
+export const QTYPES = { choice: 0, score: 1, noul: 2 } as const;
+export type QuestionType = keyof typeof QTYPES;
+
+/** A question in the Decision Index schema. */
+export type Question =
+  | { type: 'noul'; instructions: string; criteria?: { true?: string; false?: string } }
+  | { type: 'choice'; instructions: string; criteria: Record<string, string> }
+  | { type: 'score'; instructions: string; criteria: readonly string[] };
+
+export type Answer =
+  | { type: 'noul'; noul: number }
+  | { type: 'choice'; choice: string; confidence: number; probabilities: Record<string, number> }
+  | { type: 'score'; score: number; confidence: number; probabilities: Record<string, number> };
+
+/** The tokenizer surface the encoder needs. */
+export interface D1Tokenizer {
+  encode(text: string): number[];
+  tokenId(token: string): number;
+  bosId: number;
+}
+
+const DELIM = {
+  state: '<|reserved_7|>',
+  q: '<|reserved_8|>',
+  opt: '<|reserved_9|>',
+  optEnd: '<|reserved_10|>',
+  decide: '<|reserved_11|>',
+};
+const MARKER = '<|mask|>';
+/** How image questions were trained: noul options read as plain yes/no. */
+export const YES_NO = { false: 'no', true: 'yes' } as const;
+
+/** `<|name|>` to `<¦name¦>`, so caller text cannot forge a delimiter. */
+const escape = (text: string): string => text.replace(/<\|([A-Za-z0-9_]+)\|>/g, '<¦$1¦>');
+
+export const optionCount = (q: Question): number =>
+  q.type === 'noul' ? 2 : q.type === 'choice' ? Object.keys(q.criteria).length : q.criteria.length;
+
+/** Option texts in the model's order; a noul reads as [false, true]. */
+function renderOptions(q: Question, noulDefault?: { false: string; true: string }): string[] {
+  if (q.type === 'choice') {
+    return Object.entries(q.criteria).map(([k, v]) => (v ? `${k}: ${v}` : k));
+  }
+  if (q.type === 'score') return q.criteria.map((c, i) => `level ${i}: ${c}`);
+  const crit = q.criteria ?? noulDefault ?? {};
+  return [
+    'false: ' + (crit.false || 'no, the statement does not hold'),
+    'true: ' + (crit.true || 'yes, the statement holds'),
+  ];
+}
+
+/** Token ids of one complete question and state, and each option marker's position. */
+export function encodeQuestion(
+  tok: D1Tokenizer,
+  state: string,
+  q: Question,
+  maxLen: number,
+  noulDefault?: { false: string; true: string },
+): { ids: number[]; markers: number[] } {
+  const enc = (s: string) => tok.encode(escape(s));
+  const opts = renderOptions(q, noulDefault);
+  const question = [tok.tokenId(DELIM.q), ...enc(q.instructions)];
+  const markers: number[] = [];
+  for (const text of opts) {
+    markers.push(question.length + 1);
+    question.push(
+      tok.tokenId(DELIM.opt),
+      tok.tokenId(MARKER),
+      ...enc(' ' + text),
+      tok.tokenId(DELIM.optEnd),
+    );
+  }
+  question.push(tok.tokenId(DELIM.decide));
+  const room = Math.max(0, maxLen - question.length - 2);
+  const stateTokens = enc(state);
+  if (question.length + 2 > maxLen || stateTokens.length > room) {
+    throw new RunntimeError(
+      'INVALID_ARGUMENT',
+      `D1 prompt exceeds its ${maxLen}-token context (${stateTokens.length} state tokens and ${question.length} question tokens)`,
+    );
+  }
+  const stateIds = [tok.tokenId(DELIM.state), ...stateTokens];
+  const ids = [tok.bosId, ...stateIds, ...question];
+  const shifted = markers.map((m) => m + 1 + stateIds.length);
+  return { ids, markers: shifted };
+}
+
+/** Temperature-table key for a question with k options. */
+export function temperatureKey(q: Question): string {
+  const k = optionCount(q);
+  return `${q.type}:` + (k <= 2 ? '2' : k <= 5 ? '3-5' : k <= 10 ? '6-10' : '11+');
+}
+
+/** Softmax over the option logits, divided by `temperature` first. */
+export function softmaxT(logits: readonly number[], temperature: number): number[] {
+  const z = logits.map((l) => l / temperature);
+  const max = Math.max(...z);
+  const e = z.map((v) => Math.exp(v - max));
+  const sum = e.reduce((a, b) => a + b, 0);
+  return e.map((v) => v / sum);
+}
+
+/** Probabilities in option order (noul as [yes, no]) to the typed answer. */
+export function toAnswer(q: Question, probs: readonly number[]): Answer {
+  if (q.type === 'noul') return { type: 'noul', noul: probs[0]! };
+  let best = 0;
+  for (let i = 1; i < probs.length; i++) if (probs[i]! > probs[best]!) best = i;
+  if (q.type === 'choice') {
+    const names = Object.keys(q.criteria);
+    return {
+      type: 'choice',
+      choice: names[best]!,
+      confidence: probs[best]!,
+      probabilities: Object.fromEntries(names.map((n, i) => [n, probs[i]!])),
+    };
+  }
+  return {
+    type: 'score',
+    score: probs.reduce((s, p, i) => s + i * p, 0),
+    confidence: probs[best]!,
+    probabilities: Object.fromEntries(probs.map((p, i) => [String(i), p])),
+  };
+}
diff --git a/packages/runntime/src/zoo/d1/stateDictHooks.ts b/packages/runntime/src/zoo/d1/stateDictHooks.ts
new file mode 100644
index 0000000..7a97b4c
--- /dev/null
+++ b/packages/runntime/src/zoo/d1/stateDictHooks.ts
@@ -0,0 +1,164 @@
+/** Maps the d1-omni checkpoint onto D1Model's parameter tree as lazy derived
+ *  tensors; nothing is fetched here. Audio tensors are dropped. Weights stay
+ *  in torch layout for the core Linear hook to transpose. */
+
+import { derivedTensor, type LazyStateDict, type LazyTensor } from '../../core/index.ts';
+import { checkpointMismatch } from '../errors.ts';
+
+const HIDDEN = 1024;
+const HEAD_DIM = 64;
+const VISION = 768;
+const LAYER_TYPES = 'ccaccaccacacacac';
+const HEAD_LAYERS = 2;
+const VISION_LAYERS = 12;
+
+function take(sd: LazyStateDict, name: string): LazyTensor {
+  const t = sd.tensors.get(name);
+  if (!t) throw checkpointMismatch('d1 state dict', `missing tensor '${name}'`);
+  sd.tensors.delete(name);
+  return t;
+}
+
+const move = (sd: LazyStateDict, from: string, to: string) => sd.tensors.set(to, take(sd, from));
+
+/** Rows (or elements, for a vector) scaled, and within each head of
+ *  `HEAD_DIM` reordered from rotate-half to interleaved pairs:
+ *  new 2i = old i, new 2i+1 = old i + HEAD_DIM/2. */
+function ropeRows(t: LazyTensor, scale = 1): LazyTensor {
+  const rows = t.shape[0]!;
+  const cols = t.shape.length === 2 ? t.shape[1]! : 1;
+  const half = HEAD_DIM / 2;
+  return derivedTensor(
+    t.shape,
+    async () => {
+      const src = await t.f32();
+      const out = new Float32Array(src.length);
+      for (let r = 0; r < rows; r++) {
+        const head = r - (r % HEAD_DIM);
+        const i = r % HEAD_DIM;
+        const from = head + (i % 2 === 0 ? i / 2 : half + (i - 1) / 2);
+        for (let c = 0; c < cols; c++) out[r * cols + c] = src[from * cols + c]! * scale;
+      }
+      return out;
+    },
+    t.byteLength,
+  );
+}
+
+/** Row-stacks torch-layout tensors, scaling the rows [0, scaledRows) of the
+ *  result by `scale`. */
+function stackRows(parts: LazyTensor[], scale = 1, scaledRows = 0): LazyTensor {
+  const cols = parts[0]!.shape.length === 2 ? parts[0]!.shape[1]! : 1;
+  const rows = parts.reduce((s, p) => s + p.shape[0]!, 0);
+  return derivedTensor(
+    cols === 1 ? [rows] : [rows, cols],
+    async () => {
+      const out = new Float32Array(rows * cols);
+      let base = 0;
+      for (const p of parts) {
+        const data = await p.f32();
+        out.set(data, base);
+        base += data.length;
+      }
+      for (let i = 0; i < scaledRows * cols; i++) out[i]! *= scale;
+      return out;
+    },
+    parts.reduce((s, p) => s + p.byteLength, 0),
+  );
+}
+
+/** Scales the first `rows` rows of a torch-layout tensor. */
+const scaleRows = (t: LazyTensor, rows: number, scale: number) => stackRows([t], scale, rows);
+
+/** The depthwise conv weight [hidden, 1, 3] split into its three taps. */
+function convTaps(sd: LazyStateDict, from: string, to: string): void {
+  const w = take(sd, from);
+  const taps = async () => w.f32();
+  for (let k = 0; k < 3; k++) {
+    sd.tensors.set(
+      `${to}.tap${k}`,
+      derivedTensor(
+        [HIDDEN],
+        async () => {
+          const src = await taps();
+          return Float32Array.from({ length: HIDDEN }, (_, c) => src[c * 3 + k]!);
+        },
+        k === 0 ? w.byteLength : 0,
+      ),
+    );
+  }
+}
+
+export function transformD1StateDict(sd: LazyStateDict): void {
+  for (const name of [...sd.tensors.keys()]) if (name.startsWith('audio.')) sd.tensors.delete(name);
+  const qScale = 1 / Math.sqrt(HEAD_DIM);
+
+  move(sd, 'encoder.embedding_norm.weight', 'encoder.embedding_norm.scale');
+  [...LAYER_TYPES].forEach((kind, i) => {
+    const p = `encoder.layers.${i}`;
+    move(sd, `${p}.operator_norm.weight`, `${p}.operator_norm.scale`);
+    move(sd, `${p}.ffn_norm.weight`, `${p}.ffn_norm.scale`);
+    const w1 = take(sd, `${p}.feed_forward.w1.weight`);
+    const w3 = take(sd, `${p}.feed_forward.w3.weight`);
+    sd.tensors.set(`${p}.feed_forward.w13.weight`, stackRows([w3, w1]));
+    if (kind === 'c') {
+      convTaps(sd, `${p}.conv.conv.weight`, `${p}.conv`);
+      return;
+    }
+    const a = `${p}.self_attn`;
+    sd.tensors.set(`${a}.q_proj.weight`, ropeRows(take(sd, `${a}.q_proj.weight`)));
+    sd.tensors.set(`${a}.k_proj.weight`, ropeRows(take(sd, `${a}.k_proj.weight`)));
+    sd.tensors.set(`${a}.q_layernorm.scale`, ropeRows(take(sd, `${a}.q_layernorm.weight`), qScale));
+    sd.tensors.set(`${a}.k_layernorm.scale`, ropeRows(take(sd, `${a}.k_layernorm.weight`)));
+  });
+
+  for (let i = 0; i < HEAD_LAYERS; i++) {
+    const from = `head.head.layers.${i}`;
+    const to = `head.layers.${i}`;
+    sd.tensors.set(
+      `${to}.in_proj.weight`,
+      scaleRows(take(sd, `${from}.self_attn.in_proj_weight`), HIDDEN, qScale),
+    );
+    sd.tensors.set(
+      `${to}.in_proj.bias`,
+      scaleRows(take(sd, `${from}.self_attn.in_proj_bias`), HIDDEN, qScale),
+    );
+    for (const n of ['out_proj.weight', 'out_proj.bias'])
+      move(sd, `${from}.self_attn.${n}`, `${to}.${n}`);
+    for (const m of ['linear1', 'linear2', 'norm1', 'norm2']) {
+      for (const n of ['weight', 'bias']) move(sd, `${from}.${m}.${n}`, `${to}.${m}.${n}`);
+    }
+  }
+  for (const [from, to] of [
+    ['0', 'scorer_norm'],
+    ['1', 'scorer_fc'],
+    ['3', 'scorer_out'],
+  ] as const) {
+    for (const n of ['weight', 'bias']) move(sd, `head.scorer.${from}.${n}`, `head.${to}.${n}`);
+  }
+
+  const v = 'vision.tower.vision_model';
+  for (const n of ['patch_embedding.weight', 'patch_embedding.bias']) {
+    move(sd, `${v}.embeddings.${n}`, `vision.${n}`);
+  }
+  move(sd, `${v}.embeddings.position_embedding.weight`, 'vision.position_embedding');
+  for (const n of ['weight', 'bias'])
+    move(sd, `${v}.post_layernorm.${n}`, `vision.post_layernorm.${n}`);
+  for (const n of ['linear_1', 'linear_2']) {
+    for (const k of ['weight', 'bias']) move(sd, `vision.projector.${n}.${k}`, `vision.${n}.${k}`);
+  }
+  for (let i = 0; i < VISION_LAYERS; i++) {
+    const from = `${v}.encoder.layers.${i}`;
+    const to = `vision.layers.${i}`;
+    for (const k of ['weight', 'bias']) {
+      const qkv = ['q_proj', 'k_proj', 'v_proj'].map((n) =>
+        take(sd, `${from}.self_attn.${n}.${k}`),
+      );
+      sd.tensors.set(`${to}.qkv.${k}`, stackRows(qkv, qScale, VISION));
+      move(sd, `${from}.self_attn.out_proj.${k}`, `${to}.out_proj.${k}`);
+      for (const m of ['layer_norm1', 'layer_norm2'])
+        move(sd, `${from}.${m}.${k}`, `${to}.${m}.${k}`);
+      for (const m of ['fc1', 'fc2']) move(sd, `${from}.mlp.${m}.${k}`, `${to}.${m}.${k}`);
+    }
+  }
+}
