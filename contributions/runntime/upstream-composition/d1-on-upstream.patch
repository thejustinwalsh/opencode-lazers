+    $('speed').textContent = `${ms.toFixed(0)} ms · ${(1000 / ms).toFixed(1)} fps`;
+    if (first) {
+      $('loading').remove();
+      first = false;
+    }
+    if (still) await new Promise((r) => setTimeout(r, 1000));
+  }
+}
