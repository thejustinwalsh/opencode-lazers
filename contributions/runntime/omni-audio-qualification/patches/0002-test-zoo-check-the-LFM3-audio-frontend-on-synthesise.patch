+/** The log-mel frontend against a first-principles reference on synthesised signals. */
+
+import { describe, expect, it } from 'vitest';
+import {
+  lfm3AudioFrameCount,
+  lfm3LogMelSpectrogram,
+} from '../../../../../src/zoo/lfm3/audio/frontend.ts';
+import { melBandAt, referenceFrameCount, referenceLogMel } from './melReference.ts';
+import { chirp, clippedSine, impulse, sine } from './signals.ts';
+
+const SILENCE_FLOOR = (Math.log10(1e-12) + 4) / 4;
+
+function maxAbsoluteDifference(actual: Float32Array, expected: Float32Array): number {
+  expect(actual).toHaveLength(expected.length);
+  let worst = 0;
+  for (let index = 0; index < actual.length; index++) {
+    worst = Math.max(worst, Math.abs(actual[index]! - expected[index]!));
+  }
+  return worst;
+}
+
+const SIGNALS: readonly { name: string; audio: Float32Array }[] = [
+  { name: 'a 1 kHz sine', audio: sine(1_000, 1_600, 16_000, 0.5) },
+  { name: 'a 100 Hz to 7 kHz chirp', audio: chirp(100, 7_000, 1_600, 16_000, 0.5) },
+  { name: 'an impulse inside the first frame', audio: impulse(960, 200) },
+  { name: 'an impulse on a frame boundary', audio: impulse(960, 480, 0.8) },
+  { name: 'silence', audio: new Float32Array(800) },
+  { name: 'a sine clipped at 4x gain', audio: clippedSine(440, 1_600, 4) },
+  { name: 'a sine shorter than one frame', audio: sine(2_000, 150, 16_000, 0.3) },
+  { name: 'a signal one sample past a frame boundary', audio: sine(300, 561, 16_000, 0.3) },
+];
+
+describe('LFM3-Omni frontend on synthesised signals', () => {
+  it.each(SIGNALS)('matches the direct-DFT reference for $name', ({ audio }) => {
+    const actual = lfm3LogMelSpectrogram(audio);
+    expect(lfm3AudioFrameCount(audio.length)).toBe(referenceFrameCount(audio.length));
+    // Float32 storage of a value near 0 to 1 bounds the comparison, not the DFT.
+    expect(maxAbsoluteDifference(actual, referenceLogMel(audio))).toBeLessThan(1e-4);
+  });
+
+  it('puts a pure tone in the mel band that contains it', () => {
+    const frames = lfm3AudioFrameCount(1_600);
+    const mel = lfm3LogMelSpectrogram(sine(1_000, 1_600, 16_000, 0.5));
+    const frame = 3;
+    let loudest = 0;
+    for (let band = 0; band < 128; band++) {
+      if (mel[band * frames + frame]! > mel[loudest * frames + frame]!) loudest = band;
+    }
+    expect(Math.abs(loudest - melBandAt(1_000))).toBeLessThanOrEqual(1);
+  });
+
+  it('moves a chirp up the mel axis frame by frame', () => {
+    const audio = chirp(200, 6_000, 4_800, 16_000, 0.5);
+    const frames = lfm3AudioFrameCount(audio.length);
+    const mel = lfm3LogMelSpectrogram(audio);
+    const loudestBand = (frame: number): number => {
+      let best = 0;
+      for (let band = 0; band < 128; band++) {
+        if (mel[band * frames + frame]! > mel[best * frames + frame]!) best = band;
+      }
+      return best;
+    };
+    expect(loudestBand(5)).toBeLessThan(loudestBand(frames >> 1));
+    expect(loudestBand(frames >> 1)).toBeLessThan(loudestBand(frames - 8));
+  });
+
+  it('adds log10(4) / 4 to every band when the amplitude doubles', () => {
+    const quiet = lfm3LogMelSpectrogram(sine(700, 1_200, 16_000, 0.1));
+    const loud = lfm3LogMelSpectrogram(sine(700, 1_200, 16_000, 0.2));
+    for (let index = 0; index < quiet.length; index++) {
+      if (quiet[index]! > SILENCE_FLOOR + 0.05) {
+        expect(loud[index]! - quiet[index]!).toBeCloseTo(Math.log10(4) / 4, 3);
+      }
+    }
+  });
+
+  it('holds silence at the log floor and keeps a clipped signal finite', () => {
+    expect(
+      lfm3LogMelSpectrogram(new Float32Array(1_000)).every((value) => value === SILENCE_FLOOR),
+    ).toBe(true);
+    expect(lfm3LogMelSpectrogram(clippedSine(220, 3_200, 50)).every(Number.isFinite)).toBe(true);
+  });
+});
diff --git a/packages/runntime/test/zoo/lfm3/audio/qualification/melReference.ts b/packages/runntime/test/zoo/lfm3/audio/qualification/melReference.ts
new file mode 100644
index 0000000..dc4e3ec
--- /dev/null
+++ b/packages/runntime/test/zoo/lfm3/audio/qualification/melReference.ts
@@ -0,0 +1,78 @@
+/** First-principles log-mel reference: a direct DFT and Slaney triangles, no shared code with src. */
+
+const FFT_SIZE = 400;
+const HOP = 160;
+const BINS = FFT_SIZE / 2 + 1;
+const SAMPLE_RATE = 16_000;
+const MELS = 128;
+
+const toMel = (hz: number): number =>
+  hz >= 1_000 ? 15 + (Math.log(hz / 1_000) * 27) / Math.log(6.4) : (3 * hz) / 200;
+const fromMel = (mel: number): number =>
+  mel >= 15 ? 1_000 * Math.exp((Math.log(6.4) * (mel - 15)) / 27) : (200 * mel) / 3;
+
+/** Number of frames: one, then one more per hop until the right-padded signal is covered. */
+export function referenceFrameCount(samples: number): number {
+  return samples <= FFT_SIZE ? 1 : 1 + Math.ceil((samples - FFT_SIZE) / HOP);
+}
+
+/** Log-mel in [mel, frame] order: (log10(max(power energy, 1e-12)) + 4) / 4 on 128 Slaney bands. */
+export function referenceLogMel(audio: Float32Array): Float32Array {
+  const frames = referenceFrameCount(audio.length);
+  const edges = Array.from({ length: MELS + 2 }, (_, index) =>
+    fromMel((toMel(SAMPLE_RATE / 2) * index) / (MELS + 1)),
+  );
+  const output = new Float32Array(MELS * frames);
+  const cosines = Float64Array.from({ length: FFT_SIZE }, (_, n) =>
+    Math.cos((2 * Math.PI * n) / FFT_SIZE),
+  );
+  const sines = Float64Array.from({ length: FFT_SIZE }, (_, n) =>
+    Math.sin((2 * Math.PI * n) / FFT_SIZE),
+  );
+  for (let frame = 0; frame < frames; frame++) {
+    const windowed = Float64Array.from(
+      { length: FFT_SIZE },
+      (_, n) =>
+        (audio[frame * HOP + n] ?? 0) * (0.5 - 0.5 * Math.cos((2 * Math.PI * n) / FFT_SIZE)),
+    );
+    const power = new Float64Array(BINS);
+    for (let bin = 0; bin < BINS; bin++) {
+      let real = 0;
+      let imaginary = 0;
+      for (let n = 0; n < FFT_SIZE; n++) {
+        const index = (bin * n) % FFT_SIZE;
+        real += windowed[n]! * cosines[index]!;
+        imaginary -= windowed[n]! * sines[index]!;
+      }
+      power[bin] = real * real + imaginary * imaginary;
+    }
+    for (let mel = 0; mel < MELS; mel++) {
+      const lower = edges[mel]!;
+      const center = edges[mel + 1]!;
+      const upper = edges[mel + 2]!;
+      let energy = 0;
+      for (let bin = 0; bin < BINS; bin++) {
+        const hz = (bin * SAMPLE_RATE) / 2 / (BINS - 1);
+        const triangle = Math.max(
+          0,
+          Math.min((hz - lower) / (center - lower), (upper - hz) / (upper - center)),
+        );
+        energy += power[bin]! * triangle * (2 / (upper - lower));
+      }
+      output[mel * frames + frame] = (Math.log10(Math.max(energy, 1e-12)) + 4) / 4;
+    }
+  }
+  return output;
+}
+
+/** Index of the mel band whose triangle is centered nearest `hz`. */
+export function melBandAt(hz: number): number {
+  const edges = Array.from({ length: MELS + 2 }, (_, index) =>
+    fromMel((toMel(SAMPLE_RATE / 2) * index) / (MELS + 1)),
+  );
+  let best = 0;
+  for (let mel = 0; mel < MELS; mel++) {
+    if (Math.abs(edges[mel + 1]! - hz) < Math.abs(edges[best + 1]! - hz)) best = mel;
+  }
+  return best;
+}
diff --git a/packages/runntime/test/zoo/lfm3/audio/qualification/signals.ts b/packages/runntime/test/zoo/lfm3/audio/qualification/signals.ts
new file mode 100644
index 0000000..b416607
--- /dev/null
+++ b/packages/runntime/test/zoo/lfm3/audio/qualification/signals.ts
@@ -0,0 +1,110 @@
+/** Deterministic synthetic signals for the audio frontend and round-trip qualification. */
+
+export function sine(
+  frequency: number,
+  samples: number,
+  sampleRate = 16_000,
+  amplitude = 1,
+): Float32Array {
+  return Float32Array.from(
+    { length: samples },
+    (_, index) => amplitude * Math.sin((2 * Math.PI * frequency * index) / sampleRate),
+  );
+}
+
+/** Linear chirp from `from` to `to` Hz over the whole clip. */
+export function chirp(
+  from: number,
+  to: number,
+  samples: number,
+  sampleRate = 16_000,
+  amplitude = 1,
+): Float32Array {
+  const seconds = samples / sampleRate;
+  return Float32Array.from({ length: samples }, (_, index) => {
+    const time = index / sampleRate;
+    return (
+      amplitude *
+      Math.sin(2 * Math.PI * (from * time + ((to - from) * time * time) / (2 * seconds)))
+    );
+  });
+}
+
+export function impulse(samples: number, at: number, amplitude = 1): Float32Array {
+  const output = new Float32Array(samples);
+  output[at] = amplitude;
+  return output;
+}
+
+/** A sine driven `gain` times past full scale and hard-clipped to [-1, 1]. */
+export function clippedSine(
+  frequency: number,
+  samples: number,
+  gain: number,
+  sampleRate = 16_000,
+): Float32Array {
+  return sine(frequency, samples, sampleRate, gain).map((value) =>
+    Math.max(-1, Math.min(1, value)),
+  );
+}
+
+/** Concatenates clips with `gap` samples of silence between them. */
+export function joinWithSilence(clips: readonly Float32Array[], gap: number): Float32Array {
+  const length =
+    clips.reduce((sum, clip) => sum + clip.length, 0) + gap * Math.max(0, clips.length - 1);
+  const output = new Float32Array(length);
+  let offset = 0;
+  for (const clip of clips) {
+    output.set(clip, offset);
+    offset += clip.length + gap;
+  }
+  return output;
+}
+
+/** Peak and RMS of a clip, for level checks on generated speech. */
+export function levels(samples: Float32Array): { peak: number; rms: number; clipped: number } {
+  let peak = 0;
+  let sumSquares = 0;
+  let clipped = 0;
+  for (const sample of samples) {
+    peak = Math.max(peak, Math.abs(sample));
+    sumSquares += sample * sample;
+    if (Math.abs(sample) >= 1) clipped++;
+  }
+  return { peak, rms: Math.sqrt(sumSquares / Math.max(1, samples.length)), clipped };
+}
+
+/** Mono 16-bit PCM RIFF/WAVE bytes at any sample rate. */
+export function encodePcm16Wav(channels: readonly Float32Array[], sampleRate: number): ArrayBuffer {
+  const frames = channels[0]!.length;
+  const buffer = new ArrayBuffer(44 + frames * channels.length * 2);
+  const view = new DataView(buffer);
+  const text = (offset: number, value: string): void => {
+    for (let index = 0; index < value.length; index++)
+      view.setUint8(offset + index, value.charCodeAt(index));
+  };
+  text(0, 'RIFF');
+  view.setUint32(4, buffer.byteLength - 8, true);
+  text(8, 'WAVE');
+  text(12, 'fmt ');
+  view.setUint32(16, 16, true);
+  view.setUint16(20, 1, true);
+  view.setUint16(22, channels.length, true);
+  view.setUint32(24, sampleRate, true);
+  view.setUint32(28, sampleRate * channels.length * 2, true);
+  view.setUint16(32, channels.length * 2, true);
+  view.setUint16(34, 16, true);
+  text(36, 'data');
+  view.setUint32(40, frames * channels.length * 2, true);
+  for (let frame = 0; frame < frames; frame++) {
+    for (let channel = 0; channel < channels.length; channel++) {
+      const sample = Math.max(-1, Math.min(1, channels[channel]![frame]!));
+      view.setInt16(
+        44 + (frame * channels.length + channel) * 2,
+        Math.round(sample * 32_767),
+        true,
+      );
+    }
+  }
+  return buffer;
+}
diff --git a/packages/runntime/test/zoo/lfm3/audio/qualification/wer.test.ts b/packages/runntime/test/zoo/lfm3/audio/qualification/wer.test.ts
