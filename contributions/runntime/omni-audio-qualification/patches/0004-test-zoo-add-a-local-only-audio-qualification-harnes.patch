@@ -0,0 +1,19 @@
+/** Runs the pinned Liquid engine comparisons (audio encoder, depth codes, codec PCM) from local
+ *  files only: the engine bundle, the GGUF pair and the regenerated frozen clips are all same-origin. */
+
+import { afterAll, it } from 'vitest';
+import { MODE, installNetworkGuard, report } from './audio/qualification/harness.ts';
+
+if (MODE === 'liquid-reference') {
+  const guard = installNetworkGuard();
+  afterAll(() => {
+    report('network', {
+      mode: 'audio-liquid-reference',
+      sameOriginRequests: guard.requests.length,
+      blocked: guard.blocked,
+    });
+  });
+  await import('./audio-reference.gpu.test.ts');
+} else {
+  it.skip('needs VITE_LFM3_QUALIFICATION_MODE=liquid-reference');
+}
diff --git a/packages/runntime/test/zoo/lfm3/audio-qualification.gpu.test.ts b/packages/runntime/test/zoo/lfm3/audio-qualification.gpu.test.ts
new file mode 100644
index 0000000..c6c652e
--- /dev/null
+++ b/packages/runntime/test/zoo/lfm3/audio-qualification.gpu.test.ts
@@ -0,0 +1,447 @@
+/** Audio qualification on a real WebGPU device, from local weights only.
+ *  Modes (VITE_LFM3_QUALIFICATION_MODE): audio-roundtrip, audio-streaming, audio-input, audio-memory.
+ *  Run them through `pnpm --filter runntime test:audio`. */
+
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { decodeAudio, resampleAudio } from '../../../src/zoo/index.ts';
+import { liveBuffers } from '../../gpu.ts';
+import {
+  adapterInfo,
+  gpuBufferBytes,
+  loadAudio,
+  MODE,
+  report,
+  round,
+  seeds,
+  selectedVoices,
+  SENTENCES,
+  VOICES,
+  type LoadedAudio,
+} from './audio/qualification/harness.ts';
+import {
+  chirp,
+  encodePcm16Wav,
+  joinWithSilence,
+  levels,
+  sine,
+} from './audio/qualification/signals.ts';
+import { WER_LIMITS } from './audio/qualification/thresholds.ts';
+import { wordErrorRate } from './audio/qualification/wer.ts';
+
+let loaded: LoadedAudio;
+
+function useModel(mode: string): void {
+  beforeAll(async () => {
+    loaded = await loadAudio();
+    report('load', {
+      mode,
+      adapter: await adapterInfo(),
+      loadMs: round(loaded.loadMs, 1),
+      sourceBytes: loaded.sourceBytes,
+      loadedGpuBytes: loaded.loadedGpuBytes,
+    });
+  }, 600_000);
+  afterAll(async () => {
+    await loaded?.audio.dispose();
+    report('network', {
+      mode,
+      sameOriginRequests: loaded?.guard.requests.length,
+      blocked: loaded?.guard.blocked,
+    });
+  }, 120_000);
+}
+
+describe.skipIf(MODE !== 'audio-roundtrip')('audio round trip: text to speech to text', () => {
+  useModel('audio-roundtrip');
+
+  it('speaks every sentence in every voice and transcribes it back within the measured word error rate', async () => {
+    const rows: Record<string, unknown>[] = [];
+    for (const seed of seeds()) {
+      for (const { id, voice } of selectedVoices()) {
+        for (const sentence of SENTENCES) {
+          const speakStarted = performance.now();
+          const generation = loaded.audio.speak(sentence, { seed, voice, maxAudioFrames: 512 });
+          const chunks: Float32Array[] = [];
+          for await (const chunk of generation) chunks.push(chunk);
+          const speech = await generation.result;
+          const speakMs = performance.now() - speakStarted;
+          expect(speech.sampleRate).toBe(24_000);
+          expect(speech.finishReason, `${id} "${sentence}" stopped on its own`).toBe('stop');
+          expect(chunks.reduce((sum, chunk) => sum + chunk.length, 0)).toBe(speech.samples.length);
+          const transcribeStarted = performance.now();
+          const transcript = await loaded.audio.transcribe(
+            await resampleAudio(speech.samples, speech.sampleRate),
+          );
+          const transcribeMs = performance.now() - transcribeStarted;
+          const wer = wordErrorRate(sentence, transcript);
+          const { peak, rms, clipped } = levels(speech.samples);
+          rows.push({
+            seed,
+            voice: id,
+            sentence,
+            transcript,
+            wer: round(wer),
+            frames: speech.audioFrames,
+            samples: speech.samples.length,
+            seconds: round(speech.samples.length / 24_000, 3),
+            chunks: chunks.length,
+            peak: round(peak),
+            rms: round(rms),
+            clipped,
+            speakMs: round(speakMs, 1),
+            transcribeMs: round(transcribeMs, 1),
+          });
+        }
+      }
+    }
+    const wers = rows.map((row) => row.wer as number);
+    const summary = {
+      items: rows.length,
+      meanWer: round(wers.reduce((sum, value) => sum + value, 0) / wers.length),
+      maxWer: Math.max(...wers),
+      exact: wers.filter((value) => value === 0).length,
+      byVoice: Object.fromEntries(
+        selectedVoices().map(({ id }) => {
+          const own = rows.filter((row) => row.voice === id).map((row) => row.wer as number);
+          return [id, round(own.reduce((sum, value) => sum + value, 0) / own.length)];
+        }),
+      ),
+    };
+    report('roundtrip', { seeds: seeds(), summary, rows });
+    expect(summary.meanWer).toBeLessThanOrEqual(WER_LIMITS.meanWer);
+    expect(summary.maxWer).toBeLessThanOrEqual(WER_LIMITS.itemWer);
+  }, 3_600_000);
+});
+
+const FOX = SENTENCES[0];
+const STREAM_SEED = 1_234;
+
+async function speakAll(text: string, seed = STREAM_SEED) {
+  const generation = loaded.audio.speak(text, { seed, maxAudioFrames: 512 });
+  const chunks: Float32Array[] = [];
+  for await (const chunk of generation) chunks.push(chunk);
+  return { chunks, result: await generation.result };
+}
+
+function identical(left: Float32Array, right: Float32Array): boolean {
+  return left.length === right.length && left.every((value, index) => value === right[index]);
+}
+
+describe.skipIf(MODE !== 'audio-streaming')('speech streaming, cancellation and recovery', () => {
+  useModel('audio-streaming');
+
+  it('streams chunks that concatenate to the result and repeat exactly for one seed', async () => {
+    const first = await speakAll(FOX);
+    const second = await speakAll(FOX);
+    const joined = new Float32Array(first.chunks.reduce((sum, chunk) => sum + chunk.length, 0));
+    let offset = 0;
+    for (const chunk of first.chunks) {
+      joined.set(chunk, offset);
+      offset += chunk.length;
+    }
+    expect(first.chunks.length).toBeGreaterThan(1);
+    expect(identical(joined, first.result.samples)).toBe(true);
+    const repeat = identical(first.result.samples, second.result.samples);
+    report('streaming-determinism', {
+      chunks: first.chunks.length,
+      samples: first.result.samples.length,
+      sameSeedIdenticalSamples: repeat,
+    });
+    expect(repeat).toBe(true);
+  }, 600_000);
+
+  it('stops at maxAudioFrames with finishReason length', async () => {
+    const generation = loaded.audio.speak(FOX, { seed: STREAM_SEED, maxAudioFrames: 3 });
+    const result = await generation.result;
+    expect(result.finishReason).toBe('length');
+    expect(result.audioFrames).toBe(3);
+  }, 120_000);
+
+  it('cancels on an early break, frees its buffers and the next speech is unchanged', async () => {
+    const reference = await speakAll(FOX);
+    const bytesAfterSuccess = gpuBufferBytes();
+    const generation = loaded.audio.speak(FOX, { seed: STREAM_SEED, maxAudioFrames: 512 });
+    for await (const chunk of generation) {
+      expect(chunk.length).toBeGreaterThan(0);
+      break;
+    }
+    await expect(generation.result).rejects.toMatchObject({ code: 'EXECUTION_FAILED' });
+    const after = await speakAll(FOX);
+    const bytesAfterRecovery = gpuBufferBytes();
+    report('streaming-early-break', {
+      bytesAfterSuccess,
+      bytesAfterRecovery,
+      recoveredIdentical: identical(reference.result.samples, after.result.samples),
+    });
+    expect(identical(reference.result.samples, after.result.samples)).toBe(true);
+    expect(bytesAfterRecovery).toBe(bytesAfterSuccess);
+  }, 600_000);
+
+  it('cancels in flight with cancel() and with an AbortSignal, then recovers', async () => {
+    const byCancel = loaded.audio.speak(FOX, { seed: STREAM_SEED, maxAudioFrames: 512 });
+    const iterator = byCancel[Symbol.asyncIterator]();
+    await iterator.next();
+    byCancel.cancel();
+    await expect(byCancel.result).rejects.toMatchObject({ code: 'EXECUTION_FAILED' });
+
+    const controller = new AbortController();
+    const bySignal = loaded.audio.speak(FOX, {
+      seed: STREAM_SEED,
+      maxAudioFrames: 512,
+      signal: controller.signal,
+    });
+    const signalIterator = bySignal[Symbol.asyncIterator]();
+    await signalIterator.next();
+    controller.abort();
+    await expect(bySignal.result).rejects.toMatchObject({ code: 'EXECUTION_FAILED' });
+
+    const preAborted = new AbortController();
+    preAborted.abort();
+    await expect(
+      loaded.audio.speak(FOX, { signal: preAborted.signal }).result,
+    ).rejects.toMatchObject({ code: 'EXECUTION_FAILED' });
+
+    const recovered = await speakAll(FOX);
+    expect(recovered.result.finishReason).toBe('stop');
+  }, 600_000);
+
+  it('keeps later queued work running when a queued request fails', async () => {
+    const reference = await speakAll(FOX);
+    const running = loaded.audio.speak(FOX, { seed: STREAM_SEED, maxAudioFrames: 512 });
+    const doomed = loaded.audio.speak(SENTENCES[1], { seed: 7 });
+    const afterDoomed = loaded.audio.transcribe(
+      await resampleAudio(reference.result.samples, 24_000),
+    );
+    doomed.cancel();
+    await expect(doomed.result).rejects.toMatchObject({ code: 'EXECUTION_FAILED' });
+    const finished = await running.result;
+    const transcript = await afterDoomed;
+    report('streaming-queued-failure', {
+      runningIdentical: identical(finished.samples, reference.result.samples),
+      transcript,
+    });
+    expect(identical(finished.samples, reference.result.samples)).toBe(true);
+    expect(wordErrorRate(FOX, transcript)).toBeLessThanOrEqual(WER_LIMITS.itemWer);
+  }, 600_000);
+
+  it('rejects invalid requests before queueing them and leaves the runner usable', async () => {
+    expect(() => loaded.audio.speak('   ')).toThrowError(/must not be empty/);
+    expect(() => loaded.audio.speak(FOX, { maxAudioFrames: 0 })).toThrowError(/maxAudioFrames/);
+    expect(() => loaded.audio.speak(FOX, { seed: -1 })).toThrowError(/seed/);
+    expect(() => loaded.audio.speak(FOX, { voice: { gender: 'robot' as 'male' } })).toThrowError(
+      /gender/,
+    );
+    await expect(loaded.audio.transcribe(new Float32Array(0))).rejects.toMatchObject({
+      code: 'INVALID_ARGUMENT',
+    });
+    const speech = await speakAll(SENTENCES[1]);
+    expect(speech.result.finishReason).toBe('stop');
+  }, 600_000);
+
+  it('rejects in-flight work on dispose and refuses later calls', async () => {
+    const pending = loaded.audio.speak(FOX, { seed: STREAM_SEED, maxAudioFrames: 512 });
+    const iterator = pending[Symbol.asyncIterator]();
+    await iterator.next();
+    const disposing = loaded.audio.dispose();
+    await expect(pending.result).rejects.toMatchObject({ code: 'EXECUTION_FAILED' });
+    await disposing;
+    expect(() => loaded.audio.speak(FOX)).toThrowError(/disposed/);
+    const leaked = [...liveBuffers()].filter(
+      (buffer) => !loaded.before.has(buffer) && (buffer.usage & GPUBufferUsage.STORAGE) !== 0,
+    );
+    report('streaming-dispose', { storageBuffersAfterDispose: leaked.length });
+    expect(leaked).toEqual([]);
+  }, 600_000);
+});
+
+/** Energy of `samples` at `frequency`, by a single-bin DFT, normalised to the amplitude of a sine. */
+function amplitudeAt(samples: Float32Array, frequency: number, sampleRate: number): number {
+  let real = 0;
+  let imaginary = 0;
+  for (let index = 0; index < samples.length; index++) {
+    const phase = (2 * Math.PI * frequency * index) / sampleRate;
+    real += samples[index]! * Math.cos(phase);
+    imaginary += samples[index]! * Math.sin(phase);
+  }
+  return (2 * Math.hypot(real, imaginary)) / samples.length;
+}
+
+async function speech16k(text: string, voice?: (typeof VOICES)[number]['voice']) {
+  const generation = loaded.audio.speak(text, { seed: STREAM_SEED, voice, maxAudioFrames: 512 });
+  const result = await generation.result;
+  return { result, samples16k: await resampleAudio(result.samples, result.sampleRate) };
+}
+
+describe.skipIf(MODE !== 'audio-input')(
+  'audio input: boundaries, short clips, sample rates',
+  () => {
+    useModel('audio-input');
+
+    it('keeps the transcript through every padded-graph boundary', async () => {
+      const { samples16k } = await speech16k(FOX);
+      const baseline = await loaded.audio.transcribe(samples16k);
+      const rows = [
+        { samples: samples16k.length, transcript: baseline, wer: wordErrorRate(FOX, baseline) },
+      ];
+      // Liquid pads the waveform to 2 s * 2^k; test each side of the first boundaries past the clip.
+      for (const boundary of [64_000, 128_000]) {
+        for (const length of [boundary, boundary + 1]) {
+          if (length < samples16k.length) continue;
+          const padded = new Float32Array(length);
+          padded.set(samples16k);
+          const transcript = await loaded.audio.transcribe(padded);
+          rows.push({ samples: length, transcript, wer: wordErrorRate(FOX, transcript) });
+        }
+      }
+      report('input-boundaries', { rows });
+      for (const row of rows) expect(row.wer).toBeLessThanOrEqual(WER_LIMITS.itemWer);
+    }, 600_000);
+
+    it('transcribes a clip of the maximum 32 seconds and rejects one sample more', async () => {
+      const clips: Float32Array[] = [];
+      const spoken: string[] = [];
+      let total = 0;
+      for (const sentence of SENTENCES) {
+        const { samples16k } = await speech16k(sentence);
+        if (total + samples16k.length + 8_000 > 512_000) break;
+        clips.push(samples16k);
+        spoken.push(sentence);
+        total += samples16k.length + 8_000;
+      }
+      const long = joinWithSilence(clips, 8_000);
+      const maximum = new Float32Array(512_000);
+      maximum.set(long);
+      const started = performance.now();
+      const transcript = await loaded.audio.transcribe(maximum, { maxNewTokens: 512 });
+      const transcribeMs = performance.now() - started;
+      const wer = wordErrorRate(spoken.join(' '), transcript);
+      report('input-maximum-length', {
+        sentences: spoken.length,
+        speechSamples: long.length,
+        samples: maximum.length,
+        transcript,
+        wer: round(wer),
+        transcribeMs: round(transcribeMs, 1),
+      });
+      expect(wer).toBeLessThanOrEqual(WER_LIMITS.longWer);
+      await expect(loaded.audio.transcribe(new Float32Array(512_001))).rejects.toMatchObject({
+        code: 'INVALID_ARGUMENT',
+      });
+    }, 1_800_000);
+
+    it('answers silence and very short clips without failing', async () => {
+      const rows: Record<string, unknown>[] = [];
+      for (const [name, samples] of [
+        ['1 sample', new Float32Array(1)],
+        ['25 ms of silence', new Float32Array(400)],
+        ['50 ms tone', sine(440, 800, 16_000, 0.5)],
+        ['1 s of silence', new Float32Array(16_000)],
+        ['3 s of silence', new Float32Array(48_000)],
+        ['2 s chirp', chirp(200, 4_000, 32_000, 16_000, 0.5)],
+      ] as const) {
+        const started = performance.now();
+        const transcript = await loaded.audio.transcribe(samples);
+        rows.push({
+          name,
+          samples: samples.length,
+          transcript,
+          ms: round(performance.now() - started, 1),
+        });
+      }
+      report('input-silence-and-short', { rows });
+      expect(rows).toHaveLength(6);
+    }, 600_000);
+
+    it('handles sample rates: resampling and decoding keep the tone and the words', async () => {
+      const tone24 = sine(1_000, 24_000, 24_000, 0.5);
+      const tone16 = await resampleAudio(tone24, 24_000);
+      expect(tone16.length).toBe(16_000);
+      const atTone = amplitudeAt(tone16.subarray(1_000, 15_000), 1_000, 16_000);
+      const offTone = amplitudeAt(tone16.subarray(1_000, 15_000), 1_500, 16_000);
+      expect(atTone).toBeGreaterThan(0.45);
+      expect(atTone).toBeLessThan(0.55);
+      expect(offTone).toBeLessThan(0.02);
+      expect(await resampleAudio(tone16, 16_000)).toBe(tone16);
+
+      const left = sine(1_000, 48_000, 48_000, 0.5);
+      const decoded = await decodeAudio(encodePcm16Wav([left, left], 48_000));
+      expect(decoded.length).toBe(16_000);
+      expect(amplitudeAt(decoded.subarray(1_000, 15_000), 1_000, 16_000)).toBeGreaterThan(0.45);
+
+      const generated = await loaded.audio.speak(FOX, { seed: STREAM_SEED, maxAudioFrames: 512 })
+        .result;
+      const viaResample = await loaded.audio.transcribe(
+        await resampleAudio(generated.samples, 24_000),
+      );
+      const viaDecode = await loaded.audio.transcribe(
+        await decodeAudio(encodePcm16Wav([generated.samples], 24_000)),
+      );
+      const unresampled = await loaded.audio.transcribe(generated.samples);
+      const result = {
+        resampled: { transcript: viaResample, wer: round(wordErrorRate(FOX, viaResample)) },
+        decoded: { transcript: viaDecode, wer: round(wordErrorRate(FOX, viaDecode)) },
+        unresampled: { transcript: unresampled, wer: round(wordErrorRate(FOX, unresampled)) },
+      };
+      report('input-sample-rates', result);
+      expect(result.resampled.wer).toBeLessThanOrEqual(WER_LIMITS.itemWer);
+      expect(result.decoded.wer).toBeLessThanOrEqual(WER_LIMITS.itemWer);
+    }, 600_000);
+
+    it('answers a spoken question through speech, transcription and the language backbone', async () => {
+      const question = 'What is the capital of France?';
+      const { samples16k } = await speech16k(question);
+      const heard = await loaded.audio.transcribe(samples16k);
+      const reply = await loaded.audio.generate(
+        [{ role: 'user', content: `${heard} Reply with only the city.` }],
+        { maxNewTokens: 16 },
+      ).result;
+      report('input-spoken-question', {
+        heard,
+        wer: round(wordErrorRate(question, heard)),
+        reply: reply.text,
+      });
+      expect(reply.text).toMatch(/paris/i);
+    }, 600_000);
+  },
+);
+
+describe.skipIf(MODE !== 'audio-memory')('GPU memory across repeated audio runs', () => {
+  useModel('audio-memory');
+
+  it('reports GPU memory across repeated runs and releases everything on dispose', async () => {
+    const cycles = 12;
+    const rows: {
+      cycle: number;
+      sentence: string;
+      gpuBytes: number;
+      buffers: number;
+      heapBytes: number | null;
+    }[] = [];
+    for (let cycle = 0; cycle < cycles; cycle++) {
+      const sentence = SENTENCES[cycle % SENTENCES.length]!;
+      const { samples16k } = await speech16k(sentence);
+      await loaded.audio.transcribe(samples16k);
+      const memory = Reflect.get(performance, 'memory');
+      rows.push({
+        cycle,
+        sentence,
+        gpuBytes: gpuBufferBytes(),
+        buffers: liveBuffers().size,
+        heapBytes:
+          typeof memory === 'object' && memory !== null
+            ? Reflect.get(memory, 'usedJSHeapSize')
+            : null,
+      });
+    }
+    await loaded.audio.dispose();
+    const remaining = [...liveBuffers()].filter((buffer) => !loaded.before.has(buffer));
+    const storage = remaining.filter((buffer) => (buffer.usage & GPUBufferUsage.STORAGE) !== 0);
+    report('memory', {
+      loadedGpuBytes: loaded.loadedGpuBytes,
+      rows,
+      storageBuffersAfterDispose: storage.length,
+      rootCacheBytesAfterDispose: remaining.reduce((sum, buffer) => sum + buffer.size, 0),
+    });
+    expect(storage).toEqual([]);
+  }, 1_800_000);
+});
diff --git a/packages/runntime/test/zoo/lfm3/audio-qualification.mjs b/packages/runntime/test/zoo/lfm3/audio-qualification.mjs
new file mode 100644
index 0000000..76a3026
--- /dev/null
+++ b/packages/runntime/test/zoo/lfm3/audio-qualification.mjs
@@ -0,0 +1,245 @@
+/** Runs the audio qualification from local weights and prints one JSON result.
+ *  Usage: node test/zoo/lfm3/audio-qualification.mjs [--mode <name>]... [--voices a,b] [--seeds 1,2] [--out file]
+ *  Modes: audio-roundtrip, audio-streaming, audio-input, audio-memory (default: these four) and
+ *  audio-liquid-reference, which compares against the pinned Liquid engine and runs only when named.
+ *  Run from packages/runntime. Exits non-zero when any mode fails or a request would leave the machine. */
+
+import { spawnSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import {
+  createReadStream,
+  existsSync,
+  mkdirSync,
+  mkdtempSync,
+  readFileSync,
+  rmSync,
+  writeFileSync,
+} from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { parseArgs } from 'node:util';
+
+const DEFAULT_MODES = ['audio-roundtrip', 'audio-streaming', 'audio-input', 'audio-memory'];
+const MODES = [...DEFAULT_MODES, 'audio-liquid-reference'];
+const LIQUID_ENGINE = {
+  file: 'lfm3-engine.js',
+  instrumentedFile: 'lfm3-engine-instrumented.js',
+  // The comparison needs the engine's inner model; this getter is the only change made to the bundle.
+  accessor: 'get generation_config(){return this.#e.generation_config}',
+  instrumentation: 'get reference(){return this.#e}',
+  sha256: '77821949412f5dd6d60e37f22415f0e71454e65f6a73928529c6fbec0f2cf2cb',
+};
+// The frozen clips: macOS Samantha at 175 wpm, converted to 16 kHz mono PCM16. The same macOS
+// build regenerates them byte for byte, so the hashes pin them without storing audio.
+const FROZEN_CLIPS = [
+  {
+    file: 'quick-brown-fox.wav',
+    text: 'The quick brown fox jumps over the lazy dog.',
+    sha256: '0497e70d431e9d827c10bbaff120c9cbabf0834a747107f83cb161dc1f759880',
+  },
+  {
+    file: 'turn-left-next-street.wav',
+    text: 'Please turn left at the next street.',
+    sha256: 'f9ce57f4e548e339e944ba87860cd35a545db46e5eafd69f3692ede19f6cb054',
+  },
+];
+const WEIGHTS = {
+  model: 'LFM3-Omni-2B-Q4_K_M.gguf',
+  projector: 'mmproj-LFM3-Omni-2B-Q8_0.gguf',
+  tokenizer: 'lfm3-tokenizer.json',
+};
+const MARKER = 'LFM3_AUDIO_QUALIFICATION ';
+// The Liquid comparison test prints its own line; it is carried under the name `operator-reference`.
+const OPERATOR_MARKER = 'LFM3_AUDIO_OPERATOR_REFERENCE ';
+
+const { values } = parseArgs({
+  options: {
+    mode: { type: 'string', multiple: true },
+    voices: { type: 'string' },
+    seeds: { type: 'string' },
+    out: { type: 'string' },
+  },
+});
+const modes = values.mode?.length ? values.mode : DEFAULT_MODES;
+for (const mode of modes) {
+  if (!MODES.includes(mode))
+    throw new Error(`unknown mode ${mode}; expected one of ${MODES.join(', ')}`);
+}
+
+function sha256(path) {
+  return new Promise((resolve, reject) => {
+    const hash = createHash('sha256');
+    createReadStream(path)
+      .on('data', (chunk) => hash.update(chunk))
+      .on('end', () => resolve(hash.digest('hex')))
+      .on('error', reject);
+  });
+}
+
+const checksums = {};
+for (const [role, file] of Object.entries(WEIGHTS)) {
+  checksums[role] = { file, sha256: await sha256(join('test/.weights', file)) };
+}
+const git = (...args) => spawnSync('git', args, { encoding: 'utf8' }).stdout.trim();
+
+const FIXTURES = 'test/.weights/audio-fixtures';
+async function prepareLiquid() {
+  const engine = await sha256(join('test/.weights', LIQUID_ENGINE.file));
+  if (engine !== LIQUID_ENGINE.sha256) {
+    throw new Error(
+      `${LIQUID_ENGINE.file} is ${engine}, expected the pinned ${LIQUID_ENGINE.sha256}`,
+    );
+  }
+  const source = readFileSync(join('test/.weights', LIQUID_ENGINE.file), 'utf8');
+  if (source.split(LIQUID_ENGINE.accessor).length !== 2) {
+    throw new Error(
+      'the pinned Liquid engine does not contain the reference accessor location once',
+    );
+  }
+  writeFileSync(
+    join('test/.weights', LIQUID_ENGINE.instrumentedFile),
+    source.replace(
+      LIQUID_ENGINE.accessor,
+      `${LIQUID_ENGINE.instrumentation}${LIQUID_ENGINE.accessor}`,
+    ),
+  );
+  mkdirSync(FIXTURES, { recursive: true });
+  for (const clip of FROZEN_CLIPS) {
+    const path = join(FIXTURES, clip.file);
+    if (!existsSync(path)) {
+      const aiff = join(FIXTURES, `${clip.file}.aiff`);
+      for (const [command, args] of [
+        ['say', ['-v', 'Samantha', '-r', '175', '-o', aiff, clip.text]],
+        ['afconvert', ['-f', 'WAVE', '-d', 'LEI16@16000', '-c', '1', aiff, path]],
+      ]) {
+        const run = spawnSync(command, args, { encoding: 'utf8' });
+        if (run.status !== 0) throw new Error(`${command} failed: ${run.stderr}`);
+      }
+      rmSync(aiff);
+    }
+    const actual = await sha256(path);
+    if (actual !== clip.sha256) {
+      throw new Error(
+        `${clip.file} is ${actual}; the frozen clip is ${clip.sha256}. Regenerate it on the macOS build that produced it.`,
+      );
+    }
+  }
+  return {
+    engine: {
+      file: LIQUID_ENGINE.file,
+      sha256: engine,
+      instrumentation: LIQUID_ENGINE.instrumentation,
+      instrumentationSha256: createHash('sha256')
+        .update(LIQUID_ENGINE.instrumentation)
+        .digest('hex'),
+    },
+    clips: FROZEN_CLIPS,
+  };
+}
+const liquidInputs = modes.includes('audio-liquid-reference') ? await prepareLiquid() : undefined;
+
+const results = [];
+for (const mode of modes) {
+  const dir = mkdtempSync(join(tmpdir(), 'lfm3-audio-'));
+  const outputFile = join(dir, 'vitest.json');
+  const started = Date.now();
+  const run = spawnSync(
+    'pnpm',
+    [
+      'exec',
+      'vitest',
+      'run',
+      '--project',
+      'gpu',
+      mode === 'audio-liquid-reference'
+        ? 'test/zoo/lfm3/audio-liquid-reference.gpu.test.ts'
+        : 'test/zoo/lfm3/audio-qualification.gpu.test.ts',
+      '--reporter=default',
+      '--reporter=json',
+      `--outputFile.json=${outputFile}`,
+    ],
+    {
+      encoding: 'utf8',
+      maxBuffer: 1 << 28,
+      env: {
+        ...process.env,
+        VITE_LFM3_QUALIFICATION_MODE: mode === 'audio-liquid-reference' ? 'liquid-reference' : mode,
+        VITE_LFM3_LIQUID_ENGINE_URL: `/test/.weights/${LIQUID_ENGINE.instrumentedFile}`,
+        VITE_LFM3_LIQUID_MODEL_URL: `/test/.weights/${WEIGHTS.model}`,
+        VITE_LFM3_LIQUID_PROJECTOR_URL: `/test/.weights/${WEIGHTS.projector}`,
+        VITE_LFM3_LIQUID_AUDIO_INPUT_BASE_URL: '/test/.weights/audio-fixtures',
+        VITE_LFM3_MODEL_URL: `/test/.weights/${WEIGHTS.model}`,
+        VITE_LFM3_PROJECTOR_URL: `/test/.weights/${WEIGHTS.projector}`,
+        VITE_LFM3_TOKENIZER_URL: `/test/.weights/${WEIGHTS.tokenizer}`,
+        ...(values.voices ? { VITE_LFM3_AUDIO_VOICES: values.voices } : {}),
+        ...(values.seeds ? { VITE_LFM3_AUDIO_SEEDS: values.seeds } : {}),
+      },
+    },
+  );
+  const log = `${run.stdout}\n${run.stderr}`;
+  const reports = [];
+  for (const line of log.split('\n')) {
+    const at = line.indexOf(MARKER);
+    if (at >= 0) reports.push(JSON.parse(line.slice(at + MARKER.length)));
+    const operator = line.indexOf(OPERATOR_MARKER);
+    if (operator >= 0) {
+      reports.push({
+        name: 'operator-reference',
+        ...JSON.parse(line.slice(operator + OPERATOR_MARKER.length)),
+      });
+    }
+  }
+  let tests = [];
+  try {
+    const json = JSON.parse(readFileSync(outputFile, 'utf8'));
+    tests = json.testResults.flatMap((file) =>
+      file.assertionResults
+        .filter((test) => test.status !== 'skipped')
+        .map((test) => ({
+          name: test.fullName,
+          status: test.status,
+          durationMs: test.duration,
+          failure: test.failureMessages?.join('\n') || undefined,
+        })),
+    );
+  } catch {
+    // No reporter output means vitest never started a test; the exit code and log tail say why.
+  }
+  const blocked = reports
+    .filter((entry) => entry.name === 'network')
+    .flatMap((entry) => entry.blocked ?? []);
+  const passed =
+    tests.some((test) => test.status === 'passed') &&
+    tests.every((test) => test.status !== 'failed') &&
+    blocked.length === 0 &&
+    run.status === 0;
+  results.push({
+    mode,
+    passed,
+    exitCode: run.status,
+    durationMs: Date.now() - started,
+    tests,
+    reports,
+    blockedRequests: blocked,
+    logTail: passed ? undefined : log.split('\n').slice(-60).join('\n'),
+  });
+  writeFileSync(join(dir, 'console.log'), log);
+}
+
+const summary = {
+  schemaVersion: 1,
+  finishedAt: new Date().toISOString(),
+  commit: git('rev-parse', 'HEAD'),
+  branch: git('rev-parse', '--abbrev-ref', 'HEAD'),
+  dirty: git('status', '--porcelain') !== '',
+  node: process.version,
+  weights: checksums,
+  liquid: liquidInputs,
+  selection: { voices: values.voices ?? 'all', seeds: values.seeds ?? '1234' },
+  ok: results.every((result) => result.passed),
+  modes: results,
+};
+const text = JSON.stringify(summary, null, 2);
+if (values.out) writeFileSync(values.out, text);
+console.log(text);
+process.exit(summary.ok ? 0 : 1);
diff --git a/packages/runntime/test/zoo/lfm3/audio/qualification/harness.ts b/packages/runntime/test/zoo/lfm3/audio/qualification/harness.ts
new file mode 100644
index 0000000..b6e3d93
--- /dev/null
+++ b/packages/runntime/test/zoo/lfm3/audio/qualification/harness.ts
@@ -0,0 +1,166 @@
+/** Browser-side harness shared by the audio qualification modes: local-only loading,
+ *  a network guard, the fixed sentence and voice sets and the machine-readable report line. */
+
+import {
+  createLfm3Omni,
+  models,
+  type Lfm3Omni,
+  type Lfm3SpeechVoice,
+} from '../../../../../src/zoo/index.ts';
+import { gpu, liveBuffers } from '../../../../gpu.ts';
+
+declare global {
+  interface ImportMetaEnv {
+    readonly VITE_LFM3_QUALIFICATION_MODE?: string;
+    readonly VITE_LFM3_MODEL_URL?: string;
+    readonly VITE_LFM3_PROJECTOR_URL?: string;
+    readonly VITE_LFM3_TOKENIZER_URL?: string;
+    readonly VITE_LFM3_AUDIO_SEEDS?: string;
+    readonly VITE_LFM3_AUDIO_VOICES?: string;
+  }
+  interface ImportMeta {
+    readonly env: ImportMetaEnv;
+  }
+}
+
+export const MODE = import.meta.env.VITE_LFM3_QUALIFICATION_MODE;
+
+/** Fixed sentences: plain words only. No digits (ASR writes "9" for "nine") and no dialect spellings
+ *  ("harbor" and "harbour" are one word to a listener), so the rate counts recognition errors only. */
+export const SENTENCES = [
+  'The quick brown fox jumps over the lazy dog.',
+  'Please turn left at the next street.',
+  'She sells seashells by the seashore.',
+  'The meeting has been moved to Thursday afternoon.',
+  'A gentle breeze carried the scent of rain across the quiet valley.',
+  'Remember to save your work before closing the window.',
+  'The library opens early and closes late in the evening.',
+  'Our train to the coast leaves from the old station.',
+] as const;
+
+/** The four voices the product exposes: a language and a gender in the TTS system prompt. */
+export const VOICES: readonly { readonly id: string; readonly voice: Lfm3SpeechVoice }[] = [
+  { id: 'american-female', voice: { language: 'American English', gender: 'female' } },
+  { id: 'american-male', voice: { language: 'American English', gender: 'male' } },
+  { id: 'british-female', voice: { language: 'British English', gender: 'female' } },
+  { id: 'british-male', voice: { language: 'British English', gender: 'male' } },
+];
+
+/** The voices to run: all four unless VITE_LFM3_AUDIO_VOICES lists ids, so a long run can be sharded. */
+export function selectedVoices(): typeof VOICES {
+  const raw = import.meta.env.VITE_LFM3_AUDIO_VOICES;
+  if (!raw) return VOICES;
+  return raw.split(',').map((id) => {
+    const found = VOICES.find((voice) => voice.id === id);
+    if (!found) throw new Error(`unknown voice ${id}`);
+    return found;
+  });
+}
+
+/** Seeds for the round trip; the first is the canonical one the thresholds are stated for. */
+export function seeds(): number[] {
+  const raw = import.meta.env.VITE_LFM3_AUDIO_SEEDS ?? '1234';
+  return raw.split(',').map((seed) => {
+    const value = Number(seed);
+    if (!Number.isSafeInteger(value) || value < 0) throw new Error(`invalid seed ${seed}`);
+    return value;
+  });
+}
+
+function requiredEnv(name: string, value: string | undefined): string {
+  if (!value) throw new Error(`${name} is required: run the qualification through test:audio`);
+  return value;
+}
+
+/** Makes any request that leaves this origin fail the run, and records the ones that do not. */
+export function installNetworkGuard(): { readonly requests: string[]; readonly blocked: string[] } {
+  const requests: string[] = [];
+  const blocked: string[] = [];
+  const check = (input: string | URL): string => {
+    const url = new URL(input, location.href);
+    if (url.origin !== location.origin) {
+      blocked.push(url.href);
+      throw new Error(`audio qualification is local only; refused ${url.href}`);
+    }
+    requests.push(url.pathname);
+    return url.href;
+  };
+  const nativeFetch = globalThis.fetch.bind(globalThis);
+  globalThis.fetch = (input, init) =>
+    nativeFetch(check(input instanceof Request ? input.url : input), init);
+  const nativeOpen = XMLHttpRequest.prototype.open;
+  XMLHttpRequest.prototype.open = function (method: string, url: string | URL, ...rest: unknown[]) {
+    return Reflect.apply(nativeOpen, this, [method, check(url), ...rest]);
+  };
+  return { requests, blocked };
+}
+
+export const gpuBufferBytes = (): number =>
+  [...liveBuffers()].reduce((sum, buffer) => sum + buffer.size, 0);
+
+export interface LoadedAudio {
+  readonly audio: Lfm3Omni;
+  readonly loadMs: number;
+  readonly sourceBytes: number;
+  readonly loadedGpuBytes: number;
+  readonly guard: ReturnType<typeof installNetworkGuard>;
+  readonly before: ReadonlySet<GPUBuffer>;
+}
+
+/** Loads the pinned Q4_K_M and Q8_0 pair from the local weight URLs, with the network guard on. */
+export async function loadAudio(): Promise<LoadedAudio> {
+  const guard = installNetworkGuard();
+  await gpu();
+  const before = liveBuffers();
+  let sourceBytes = 0;
+  const started = performance.now();
+  const audio = await createLfm3Omni(
+    {
+      ...models.lfm3.LFM3_OMNI_2B.Q4_K_M,
+      modelPath: requiredEnv('VITE_LFM3_MODEL_URL', import.meta.env.VITE_LFM3_MODEL_URL),
+      projectorPath: requiredEnv(
+        'VITE_LFM3_PROJECTOR_URL',
+        import.meta.env.VITE_LFM3_PROJECTOR_URL,
+      ),
+      tokenizerPath: requiredEnv(
+        'VITE_LFM3_TOKENIZER_URL',
+        import.meta.env.VITE_LFM3_TOKENIZER_URL,
+      ),
+    },
+    {
+      onBytes(bytes) {
+        sourceBytes += bytes;
+      },
+    },
+  );
+  return {
+    audio,
+    loadMs: performance.now() - started,
+    sourceBytes,
+    loadedGpuBytes: gpuBufferBytes(),
+    guard,
+    before,
+  };
+}
+
+/** Adapter facts for the report. */
+export async function adapterInfo(): Promise<Record<string, unknown>> {
+  const { root } = await gpu();
+  const info = root.device.adapterInfo;
+  return {
+    label: root.device.label,
+    vendor: info?.vendor,
+    architecture: info?.architecture,
+    device: info?.device,
+    description: info?.description,
+    features: [...root.device.features].sort(),
+    userAgent: navigator.userAgent,
+  };
+}
+
+/** One JSON line the qualification script collects from the console. */
+export function report(name: string, payload: Record<string, unknown>): void {
+  console.info(`LFM3_AUDIO_QUALIFICATION ${JSON.stringify({ name, ...payload })}`);
+}
+
+export const round = (value: number, digits = 4): number => +value.toFixed(digits);
diff --git a/packages/runntime/test/zoo/lfm3/audio/qualification/thresholds.ts b/packages/runntime/test/zoo/lfm3/audio/qualification/thresholds.ts
new file mode 100644
index 0000000..c136dcb
--- /dev/null
+++ b/packages/runntime/test/zoo/lfm3/audio/qualification/thresholds.ts
@@ -0,0 +1,13 @@
+/** Limits for the audio qualification. Each is stated with the measurement it came from.
+ *  Measured on an Apple M2 Pro (Metal 3), Chromium 156 headless, Q4_K_M and Q8_0 weights. */
+
+/** 96 round trips (3 seeds x 4 voices x 8 sentences): mean 0.0015, max 0.1429 (one word of the
+ *  seven in "Please turn left at the next street", heard as "treat"), 95 exact. Seed 1234 alone: 64 of
+ *  64 exact in two runs. The mean limit allows about three wrong words in the 32 items of one seed;
+ *  the item limit is two wrong words in the shortest sentence. */
+export const WER_LIMITS = {
+  meanWer: 0.01,
+  itemWer: 2 / 7,
+  /** One 8-sentence clip of 29 s: 0 of 71 words wrong. Same per-item limit. */
+  longWer: 2 / 7,
+} as const;
