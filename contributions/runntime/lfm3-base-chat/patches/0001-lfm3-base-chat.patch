+    const output = this.o_proj.forward(gated);
+    return {
+      output,
+      cache: {
+        key: sliding ? lastRows(keys, LFM3.slidingWindow) : keys,
+        value: sliding ? lastRows(values, LFM3.slidingWindow) : values,
+      },
+    };
