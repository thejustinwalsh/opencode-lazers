+/** LFM3-Omni's causal text backbone. The audio and vision towers in the
+ *  original checkpoint are intentionally ignored by this text-only loader. */
+
+import type { TgpuRoot } from 'typegpu';
+import {
+  add,
+  cat,
+  chunk,
+  depthwiseConv1d,
+  mul,
+  nn,
+  reshape,
+  RunntimeError,
+  rope,
