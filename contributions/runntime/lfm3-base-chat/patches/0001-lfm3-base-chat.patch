+
+class Lfm3DepthwiseConv extends nn.Module<[Value, number], Value> {
+  readonly weight = new nn.Parameter({
+    elems: LFM3.hidden * LFM3.convKernel,
+    dtype: 'f32',
+    dims: [LFM3.hidden, LFM3.convKernel],
+  });
