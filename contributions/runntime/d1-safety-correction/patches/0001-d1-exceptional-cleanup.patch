diff --git a/packages/runntime/test/core/gpu/eval.gpu.test.ts b/packages/runntime/test/core/gpu/eval.gpu.test.ts
index 7edc9d88a8465c6ce9106c8a929e186e84417c1a..d6f97be016da3f7b151bab36132ceec4dab710d5 100644
