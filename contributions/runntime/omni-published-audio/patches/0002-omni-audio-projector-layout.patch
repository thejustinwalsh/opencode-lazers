diff --git a/packages/runntime/src/zoo/lfm3/audio/projector.ts b/packages/runntime/src/zoo/lfm3/audio/projector.ts
new file mode 100644
index 0000000..df8cdb6
--- /dev/null
+++ b/packages/runntime/src/zoo/lfm3/audio/projector.ts
@@ -0,0 +1,133 @@
+/** Pinned LFM3-Omni audio-projector GGUF metadata and tensor layout. */
+
+import { RunntimeError, type GgufIndex } from '../../../core/index.ts';
+
+export interface Lfm3AudioProjectorConfig {
+  readonly encoder: {
+    readonly sampleRate: 16_000;
+    readonly fftSize: 400;
+    readonly hopSize: 160;
+    readonly melBins: 128;
+    readonly hiddenSize: 768;
+    readonly feedForwardSize: 1_792;
+    readonly layers: 17;
+    readonly attentionHeads: 8;
+    readonly keyValueHeads: 4;
+    readonly attentionWindow: 32;
+    readonly outputSize: 2_048;
+  };
+  readonly depthDecoder: {
+    readonly hiddenSize: 1_024;
+    readonly feedForwardSize: 2_816;
+    readonly layers: 3;
+    readonly attentionHeads: 32;
+    readonly keyValueHeads: 8;
+    readonly codebooks: 12;
+    readonly codebookSize: 2_017;
+  };
+  readonly codec: {
+    readonly sampleRate: 24_000;
+    readonly hiddenSize: 512;
+    readonly layers: 8;
+  };
+}
+
+const CONFIG: Lfm3AudioProjectorConfig = {
+  encoder: {
+    sampleRate: 16_000,
+    fftSize: 400,
+    hopSize: 160,
+    melBins: 128,
+    hiddenSize: 768,
+    feedForwardSize: 1_792,
+    layers: 17,
+    attentionHeads: 8,
+    keyValueHeads: 4,
+    attentionWindow: 32,
+    outputSize: 2_048,
+  },
+  depthDecoder: {
+    hiddenSize: 1_024,
+    feedForwardSize: 2_816,
+    layers: 3,
+    attentionHeads: 32,
+    keyValueHeads: 8,
+    codebooks: 12,
+    codebookSize: 2_017,
+  },
+  codec: {
+    sampleRate: 24_000,
+    hiddenSize: 512,
+    layers: 8,
+  },
+};
+
+/** Checks the pinned GGUF metadata and key tensor shapes before audio loading. */
+export function validateLfm3AudioProjector(index: GgufIndex): Lfm3AudioProjectorConfig {
+  const bad = (reason: string): never => {
+    throw new RunntimeError('CHECKPOINT_MISMATCH', `LFM3-Omni audio projector: ${reason}`);
+  };
+  const metadata = index.metadata;
+  if (metadata['general.architecture'] !== 'clip') bad('expected general.architecture=clip');
+  if (metadata['clip.has_audio_encoder'] !== true) bad('projector has no audio encoder');
+  if (metadata['clip.has_gen_audio_encoder'] !== true) bad('projector has no audio generator');
+  if (metadata['clip.audio.projector_type'] !== 'lfm3a') bad('expected audio projector type lfm3a');
+  if (metadata['clip.gen.audio.projector_type'] !== 'lfm3a_gen') {
+    bad('expected generated-audio projector type lfm3a_gen');
+  }
+
+  const numbers: Readonly<Record<string, number>> = {
+    'general.file_type': 7,
+    'general.quantization_version': 2,
+    'clip.audio.projection_dim': CONFIG.encoder.outputSize,
+    'clip.audio.embedding_length': CONFIG.encoder.hiddenSize,
+    'clip.audio.feed_forward_length': CONFIG.encoder.feedForwardSize,
+    'clip.audio.block_count': CONFIG.encoder.layers,
+    'clip.audio.attention.head_count': CONFIG.encoder.attentionHeads,
+    'clip.audio.attention.head_count_kv': CONFIG.encoder.keyValueHeads,
+    'clip.audio.attention.layer_norm_epsilon': 1e-5,
+    'clip.audio.num_mel_bins': CONFIG.encoder.melBins,
+    'clip.audio.window_size': CONFIG.encoder.attentionWindow,
+    'clip.gen.audio.projection_dim': CONFIG.encoder.outputSize,
+    'clip.gen.audio.embedding_length': CONFIG.depthDecoder.hiddenSize,
+    'clip.gen.audio.feed_forward_length': CONFIG.depthDecoder.feedForwardSize,
+    'clip.gen.audio.block_count': CONFIG.depthDecoder.layers,
+    'clip.gen.audio.attention.head_count': CONFIG.depthDecoder.attentionHeads,
+    'clip.gen.audio.attention.head_count_kv': CONFIG.depthDecoder.keyValueHeads,
+    'clip.gen.audio.attention.layer_norm_epsilon': 1e-5,
+    'clip.gen.audio.sampling.temp': 0.4,
+    'clip.gen.audio.sampling.penalty_repeat': 1.2,
+    'clip.gen.audio.sampling.penalty_last_n': 64,
+  };
+  for (const [key, expected] of Object.entries(numbers)) {
+    const actual = metadata[key];
+    if (typeof actual !== 'number' || Math.fround(actual) !== Math.fround(expected)) {
+      bad(`${key} is ${JSON.stringify(actual)}, expected ${expected}`);
+    }
+  }
+
+  const tensors: ReadonlyArray<{
+    name: string;
+    shape: readonly number[];
+    type: 'F32' | 'Q8_0';
+  }> = [
+    { name: 'a.pre_encode.out.weight', shape: [768, 4_096], type: 'Q8_0' },
+    { name: 'a.blk.16.attn_q.weight', shape: [768, 768], type: 'Q8_0' },
+    { name: 'a.gen.code.embd.weight', shape: [12, 2_017, 1_024], type: 'Q8_0' },
+    { name: 'a.gen.code.blk.2.attn_q.weight', shape: [1_024, 1_024], type: 'Q8_0' },
+    { name: 'a.gen.wav.quant.first.codebook.weight', shape: [2_016, 4], type: 'F32' },
+    { name: 'a.gen.wav.tfm.blk.7.conv_dw.weight', shape: [512, 7], type: 'F32' },
+    { name: 'a.gen.wav.tfm.out_proj.weight', shape: [1_282, 512], type: 'Q8_0' },
+  ];
+  for (const expected of tensors) {
+    const actual = index.tensors.get(expected.name);
+    if (!actual) return bad(`missing ${expected.name}`);
+    if (actual.type !== expected.type || actual.shape.join() !== expected.shape.join()) {
+      bad(
+        `${expected.name} is ${actual.type} [${actual.shape.join(', ')}], expected ${expected.type} [${expected.shape.join(', ')}]`,
+      );
+    }
+  }
+
+  return CONFIG;
+}
diff --git a/packages/runntime/test/zoo/lfm3/audio/projector.test.ts b/packages/runntime/test/zoo/lfm3/audio/projector.test.ts
new file mode 100644
index 0000000..eba8cad
--- /dev/null
+++ b/packages/runntime/test/zoo/lfm3/audio/projector.test.ts
@@ -0,0 +1,128 @@
+/** Unit tests for the pinned LFM3-Omni audio-projector GGUF layout. */
+
+import { expect, it } from 'vitest';
+import { RunntimeError, type GgufIndex, type GgufTensorInfo } from '../../../../src/core/index.ts';
+import { validateLfm3AudioProjector } from '../../../../src/zoo/lfm3/audio/projector.ts';
+
+const metadata = {
+  'general.architecture': 'clip',
+  'general.file_type': 7,
+  'general.quantization_version': 2,
+  'clip.has_audio_encoder': true,
+  'clip.audio.projector_type': 'lfm3a',
+  'clip.audio.projection_dim': 2_048,
+  'clip.audio.embedding_length': 768,
+  'clip.audio.feed_forward_length': 1_792,
+  'clip.audio.block_count': 17,
+  'clip.audio.attention.head_count': 8,
+  'clip.audio.attention.head_count_kv': 4,
+  'clip.audio.attention.layer_norm_epsilon': 1e-5,
+  'clip.audio.num_mel_bins': 128,
+  'clip.audio.window_size': 32,
+  'clip.has_gen_audio_encoder': true,
+  'clip.gen.audio.projector_type': 'lfm3a_gen',
+  'clip.gen.audio.projection_dim': 2_048,
+  'clip.gen.audio.embedding_length': 1_024,
+  'clip.gen.audio.feed_forward_length': 2_816,
+  'clip.gen.audio.block_count': 3,
+  'clip.gen.audio.attention.head_count': 32,
+  'clip.gen.audio.attention.head_count_kv': 8,
+  'clip.gen.audio.attention.layer_norm_epsilon': 1e-5,
+  'clip.gen.audio.sampling.temp': 0.4,
+  'clip.gen.audio.sampling.penalty_repeat': 1.2,
+  'clip.gen.audio.sampling.penalty_last_n': 64,
+};
+
+const tensor = (name: string, shape: number[], type: GgufTensorInfo['type']): GgufTensorInfo => ({
+  name,
+  shape,
+  type,
+  begin: 0,
+  end: 4,
+});
+
+function projectorIndex(
+  overrides: {
+    metadata?: Record<string, unknown>;
+    tensors?: Map<string, GgufTensorInfo>;
+  } = {},
+): GgufIndex {
+  const tensors = new Map(
+    [
+      tensor('a.pre_encode.out.weight', [768, 4_096], 'Q8_0'),
+      tensor('a.blk.16.attn_q.weight', [768, 768], 'Q8_0'),
+      tensor('a.gen.code.embd.weight', [12, 2_017, 1_024], 'Q8_0'),
+      tensor('a.gen.code.blk.2.attn_q.weight', [1_024, 1_024], 'Q8_0'),
+      tensor('a.gen.wav.quant.first.codebook.weight', [2_016, 4], 'F32'),
+      tensor('a.gen.wav.tfm.blk.7.conv_dw.weight', [512, 7], 'F32'),
+      tensor('a.gen.wav.tfm.out_proj.weight', [1_282, 512], 'Q8_0'),
+    ].map((entry) => [entry.name, entry]),
+  );
+  for (const [name, value] of overrides.tensors ?? []) tensors.set(name, value);
+  return {
+    version: 3,
+    metadata: { ...metadata, ...overrides.metadata },
+    tensors,
+    dataStart: 0,
+    fileBytes: 4,
+  };
+}
+
+it('returns the pinned encoder, depth-decoder and codec dimensions', () => {
+  expect(validateLfm3AudioProjector(projectorIndex())).toEqual({
+    encoder: {
+      sampleRate: 16_000,
+      fftSize: 400,
+      hopSize: 160,
+      melBins: 128,
+      hiddenSize: 768,
+      feedForwardSize: 1_792,
+      layers: 17,
+      attentionHeads: 8,
+      keyValueHeads: 4,
+      attentionWindow: 32,
+      outputSize: 2_048,
+    },
+    depthDecoder: {
+      hiddenSize: 1_024,
+      feedForwardSize: 2_816,
+      layers: 3,
+      attentionHeads: 32,
+      keyValueHeads: 8,
+      codebooks: 12,
+      codebookSize: 2_017,
+    },
+    codec: { sampleRate: 24_000, hiddenSize: 512, layers: 8 },
+  });
+});
+
+it.each([
+  { key: 'clip.audio.block_count', value: 16 },
+  { key: 'clip.gen.audio.sampling.temp', value: 0 },
+  { key: 'clip.has_gen_audio_encoder', value: false },
+])('rejects mismatched projector metadata ($key)', ({ key, value }) => {
+  expect(() => validateLfm3AudioProjector(projectorIndex({ metadata: { [key]: value } }))).toThrow(
+    RunntimeError,
+  );
+});
+
+it('rejects a missing or wrong-format codec tensor', () => {
+  const index = projectorIndex();
+  index.tensors.delete('a.gen.wav.tfm.out_proj.weight');
+  expect(() => validateLfm3AudioProjector(index)).toThrow(
+    /missing a\.gen\.wav\.tfm\.out_proj\.weight/,
+  );
+
+  expect(() =>
+    validateLfm3AudioProjector(
+      projectorIndex({
+        tensors: new Map([
+          [
+            'a.gen.wav.tfm.out_proj.weight',
+            tensor('a.gen.wav.tfm.out_proj.weight', [1_282, 512], 'F32'),
+          ],
+        ]),
+      }),
+    ),
+  ).toThrow(/expected Q8_0/);
+});
