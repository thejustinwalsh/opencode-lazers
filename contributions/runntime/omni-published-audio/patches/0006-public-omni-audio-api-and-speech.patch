+          modelPath: source,
+          projectorPath: source,
+          tokenizerPath: 'unused',
+        },
+        { signal: controller.signal },
+      ),
+    ).rejects.toMatchObject({ code: 'LOAD_ABORTED' });
+    expect(reads).toBe(0);
+  });
+});
