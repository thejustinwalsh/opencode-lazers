+            'EXECUTION_FAILED',
+            `LFM3 audio encoder returned ${audioTokens ?? 'an unknown number of'} tokens; expected ${expectedTokens}`,
+          );
+        }
+        const at = positions[0]!;
+        const ids = [
+          ...prompt.slice(0, at),
+          ...Array.from({ length: expectedTokens }, () => liveBackbone.tokenizer.audioId),
+          ...prompt.slice(at + 1),
+        ];
