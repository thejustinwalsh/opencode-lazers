+        if (at > 0) parts.push(liveBackbone.embedTokens(ids.slice(0, at), uploads));
+        parts.push(features);
+        if (prompt.length - at - 1 > 0) {
+          parts.push(liveBackbone.embedTokens(ids.slice(at + expectedTokens), uploads));
