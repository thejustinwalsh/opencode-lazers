 .../runntime/src/zoo/lfm3/audio/prompts.ts    | 39 ++++++++++++++--
 packages/runntime/src/zoo/tasks/audio/lfm3.ts | 28 ++++++++++-
 .../test/zoo/lfm3/audio/prompts.test.ts       | 46 +++++++++++++++++++
 4 files changed, 108 insertions(+), 6 deletions(-)

