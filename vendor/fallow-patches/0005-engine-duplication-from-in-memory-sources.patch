+/// Run duplication detection over source text the caller supplies, with no
+/// filesystem access. Callers that want the groups touching some files filter
+/// this report; `find_duplicates_touching_files_with_defaults` prunes the corpus
+/// and can group the same code differently.
+#[must_use]
+pub fn find_duplicates_in_memory(
+    root: &Path,
+    files: &[DiscoveredFile],
+    sources: &FxHashMap<PathBuf, String>,
+    config: &DuplicatesConfig,
+) -> DuplicationAnalysis {
+    detector::detect_duplicates_in_memory(root, files, sources, config)
+}
