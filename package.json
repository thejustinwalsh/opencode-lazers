{
  "name": "opencode-lazers",
  "version": "0.2.0",
  "description": "Architect-led task orchestration and live agent panels for OpenCode.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thejustinwalsh/opencode-lazers.git"
  },
  "homepage": "https://tjw.dev/opencode-lazers/",
  "bugs": "https://github.com/thejustinwalsh/opencode-lazers/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "bun@1.4.4-canary.20261030.1",
  "exports": {
    ".": "./dist/server.js",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./webgpu/rpc": "./src/webgpu/rpc.ts",
    "./webgpu/contract": "./src/webgpu/contract.ts",
    "./webgpu/system-one": "./src/webgpu/system-one.ts"
  },
  "files": [
    "src",
    "dist",
    "licenses"
  ],
  "scripts": {
    "package:release": "bun scripts/release-package.ts",
    "test": "bun test --timeout 120000",
    "verify": "bun fmt && bun lint --fix && bun fmt && bun scripts/check-unbounded-reads.ts && bun scripts/check-show-reads.ts && bun check",
    "build:gui": "vite build && bun scripts/verify-gui-bundle.ts",
    "build:server": "bun scripts/build-server.ts",
    "build": "bun run build:gui && bun run build:server",
    "build:fallow-wasm": "bun scripts/build-fallow-wasm.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.3.0",
    "effect": "4.1.0",
    "@opencode/schema": "2.3.0",
    "@opencode/client": "2.3.0"
  },
  "devDependencies": {
    "@opencode/ai": "2.3.0",
    "@opencode/client": "2.3.0",
    "@opencode/plugin": "2.3.0",
    "@opencode/schema": "2.3.0",
    "@standard-schema/spec": "1.1.0",
    "@types/bun": "1.4.4",
    "effect": "4.1.0",
    "happy-dom": "^21.0.4",
    "solid-js": "1.9.18",
    "typegpu": "0.12.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15"
  },
  "dependencies": {
    "@tanstack/solid-virtual": "3.13.53",
    "elkjs": "0.12.1",
    "repomix": "1.18.1",
    "runntime": "https://github.com/thejustinwalsh/runntime/releases/download/lazers-omni-625c05e/runntime-0.2.0-625c05e.tgz",
    "xstate": "5.33.3",
    "zod": "4.6.7"
  }
}
