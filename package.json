{
  "name": "opencode-lazers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4-canary.20261030.1",
  "exports": {
    ".": "./dist/server.js",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./webgpu/rpc": "./src/webgpu/rpc.ts",
    "./webgpu/contract": "./src/webgpu/contract.ts",
    "./webgpu/system-one": "./src/webgpu/system-one.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "package:release": "bun scripts/release-package.ts",
    "verify": "bun fmt && bun lint --fix && bun fmt && bun check",
    "build:gui": "vite build && bun scripts/verify-gui-bundle.ts",
    "build:server": "bun scripts/build-server.ts",
    "build": "bun run build:gui && bun run build:server"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.2.5",
    "effect": "4.0.6",
    "@opencode/schema": "2.2.5",
    "@opencode/client": "2.2.5"
  },
  "devDependencies": {
    "@opencode/client": "2.2.5",
    "@opencode/plugin": "2.2.5",
    "@opencode/schema": "2.2.5",
    "@types/bun": "1.4.4",
    "effect": "4.0.6",
    "happy-dom": "^21.0.4",
    "solid-js": "1.9.18",
    "typegpu": "0.12.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15"
  },
  "dependencies": {
    "@fallow-cli/fallow-node": "3.41.0",
    "@huggingface/tokenizers": "0.2.0",
    "@tanstack/solid-virtual": "3.13.53",
    "echarts": "6.1.0",
    "elkjs": "0.12.1",
    "ignore": "7.0.14",
    "repomix": "1.18.1",
    "runntime": "https://github.com/thejustinwalsh/runntime/releases/download/lazers-omni-a3718c8/runntime-0.2.0-a3718c8.tgz",
    "xstate": "5.33.3",
    "zod": "4.6.7"
  }
