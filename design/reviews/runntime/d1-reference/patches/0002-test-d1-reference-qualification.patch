@@ -12,23 +12,40 @@ import {
 } from '../src/core/gpu/eval.ts';
 import type { Value, ValueMeta } from '../src/core/graph/value.ts';
 
-/** Every GPU buffer created on this page and not destroyed yet. Counting
- *  starts when this module loads, so a leak check compares two snapshots,
- *  never an absolute count. */
+/** GPU buffers whose device has not been destroyed or whose buffer has not
+ *  been destroyed yet. Counting starts at module load, so checks compare
+ *  snapshots rather than an absolute count. */
 const live = new Set<GPUBuffer>();
+const buffersPerDevice = new WeakMap<GPUDevice, Set<GPUBuffer>>();
+const devicePerBuffer = new WeakMap<GPUBuffer, GPUDevice>();
 // Node tests import this file for randomF32 and have no WebGPU to wrap.
 if (typeof GPUDevice !== 'undefined') {
   const createBuffer = GPUDevice.prototype.createBuffer;
+  const destroyDevice = GPUDevice.prototype.destroy;
   const destroyBuffer = GPUBuffer.prototype.destroy;
   GPUDevice.prototype.createBuffer = function (desc) {
     const buf = createBuffer.call(this, desc);
     live.add(buf);
+    let buffers = buffersPerDevice.get(this);
+    if (buffers === undefined) {
+      buffers = new Set();
+      buffersPerDevice.set(this, buffers);
+    }
+    buffers.add(buf);
+    devicePerBuffer.set(buf, this);
     return buf;
   };
   GPUBuffer.prototype.destroy = function () {
     live.delete(this);
+    const device = devicePerBuffer.get(this);
+    if (device !== undefined) buffersPerDevice.get(device)?.delete(this);
     destroyBuffer.call(this);
   };
+  GPUDevice.prototype.destroy = function () {
+    for (const buffer of buffersPerDevice.get(this) ?? []) live.delete(buffer);
+    buffersPerDevice.delete(this);
+    destroyDevice.call(this);
+  };
 }
 
 /** A snapshot of the buffers alive now. */
diff --git a/packages/runntime/test/zoo/d1/prompt.test.ts b/packages/runntime/test/zoo/d1/prompt.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..91d5e0796a16c615ae7fc42771150301dac2ce63
--- /dev/null
+++ b/packages/runntime/test/zoo/d1/prompt.test.ts
@@ -0,0 +1,82 @@
+import { describe, expect, it } from 'vitest';
+import { encodeQuestion, type D1Tokenizer } from '../../../src/zoo/d1/prompt.ts';
+
+const tokenIds = new Map<string, number>();
+const tokenizer: D1Tokenizer = {
+  encode(text) {
+    return text
+      .trim()
+      .split(/\s+/)
+      .filter(Boolean)
+      .map((token) => tokenId(token));
+  },
+  tokenId,
+  bosId: 1,
+};
+
+function tokenId(token: string): number {
+  let id = tokenIds.get(token);
+  if (id === undefined) {
+    id = tokenIds.size + 2;
+    tokenIds.set(token, id);
+  }
+  return id;
+}
+
+describe('D1 prompt packing', () => {
+  it('keeps complete state, instruction, and option text when it fits', () => {
+    const result = encodeQuestion(
+      tokenizer,
+      'customer was charged twice',
+      {
+        type: 'choice',
+        instructions: 'select a team',
+        criteria: { billing: 'charges refunds invoices', technical: 'app site faults' },
+      },
+      40,
+    );
+
+    for (const word of [
+      'customer',
+      'charged',
+      'twice',
+      'select',
+      'team',
+      'billing:',
+      'invoices',
+      'technical:',
+      'faults',
+    ]) {
+      expect(result.ids).toContain(tokenId(word));
+    }
+    expect(result.markers).toHaveLength(2);
+    expect(result.ids[result.markers[0]!]).toBe(tokenId('<|mask|>'));
+    expect(result.ids[result.markers[1]!]).toBe(tokenId('<|mask|>'));
+  });
+
+  it('rejects an overlong state instead of truncating it', () => {
+    expect(() =>
+      encodeQuestion(
+        tokenizer,
+        'one two three four five six seven eight nine ten',
+        { type: 'noul', instructions: 'is it true?' },
+        16,
+      ),
+    ).toThrow('D1 prompt exceeds its 16-token context');
+  });
+
+  it('rejects overlong instructions and options instead of truncating them', () => {
+    expect(() =>
+      encodeQuestion(
+        tokenizer,
+        '',
+        {
+          type: 'choice',
+          instructions: 'choose the best matching option from this long instruction',
+          criteria: { first: 'a lengthy option description that cannot be cut' },
+        },
+        24,
+      ),
+    ).toThrow('D1 prompt exceeds its 24-token context');
+  });
+});
diff --git a/packages/runntime/test/zoo/d1/qualification.gpu.test.ts b/packages/runntime/test/zoo/d1/qualification.gpu.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bb41b5355fadc56cb089c81bad372238cc23f43b
--- /dev/null
+++ b/packages/runntime/test/zoo/d1/qualification.gpu.test.ts
@@ -0,0 +1,546 @@
+/** Opt-in pinned D1 reference qualification on a real WebGPU device. */
+
+import { expect, it } from 'vitest';
+import tgpu from 'typegpu';
+import {
+  fromSafetensors,
+  type LazyStateDict,
+  type LazyTensor,
+} from '../../../src/core/weights/safetensors.ts';
+import { initRunntime } from '../../../src/core/gpu/eval.ts';
+import { createD1Decider } from '../../../src/zoo/d1/decider.ts';
+import type { Answer, D1Tokenizer, Question } from '../../../src/zoo/d1/prompt.ts';
+import { buffersSince, liveBuffers, gpu } from '../../gpu.ts';
+import vectors from '../../../playground/d1/reference-vectors.json';
+
+declare global {
+  interface ImportMetaEnv {
+    readonly VITE_D1_QUALIFICATION_MODE?: string;
+  }
+  interface ImportMeta {
+    readonly env: ImportMetaEnv;
+  }
+}
+
+const MODEL = 'LiquidAI/d1-omni-600M';
+const REVISION = '02b55d7076f15129e59ab3f94783f32c4b088674';
+const MODEL_URL = `https://huggingface.co/${MODEL}/resolve/${REVISION}/model.safetensors`;
+const MODE = import.meta.env.VITE_D1_QUALIFICATION_MODE;
+const TOLERANCE = 0.001;
+
+interface ReferenceCase {
+  id: string;
+  state: string;
+  question: Question;
+  reference: {
+    probabilities: number[];
+    answer: string;
+    inputTokens: number;
+    temperatureKey: string;
+    temperature: number;
+  };
+}
+
+interface ReferenceCorpus {
+  model: string;
+  revision: string;
+  probabilityTolerance: number;
+  tokenizer: {
+    revision: string;
+    bosId: number;
+    specialTokenIds: Record<string, number>;
+    inputs: { text: string; ids: number[] }[];
+  };
+  cases: ReferenceCase[];
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function isReferenceCase(value: unknown): value is ReferenceCase {
+  if (!isRecord(value)) return false;
+  const candidate = value;
+  const reference = candidate.reference;
+  if (!isRecord(reference)) return false;
+  return (
+    typeof candidate.id === 'string' &&
+    typeof candidate.state === 'string' &&
+    isRecord(candidate.question) &&
+    typeof candidate.question.type === 'string' &&
+    typeof candidate.question.instructions === 'string' &&
+    Array.isArray(reference.probabilities) &&
+    reference.probabilities.every((probability) => typeof probability === 'number') &&
+    typeof reference.answer === 'string' &&
+    typeof reference.inputTokens === 'number' &&
+    typeof reference.temperatureKey === 'string' &&
+    typeof reference.temperature === 'number'
+  );
+}
+
+function isTokenizerInput(value: unknown): value is { text: string; ids: number[] } {
+  return (
+    isRecord(value) &&
+    typeof value.text === 'string' &&
+    Array.isArray(value.ids) &&
+    value.ids.every((id) => typeof id === 'number')
+  );
+}
+
+function isReferenceCorpus(value: unknown): value is ReferenceCorpus {
+  if (!isRecord(value)) return false;
+  const candidate = value;
+  const tokenizer = candidate.tokenizer;
+  if (!isRecord(tokenizer) || !isRecord(tokenizer.specialTokenIds)) return false;
+  return (
+    candidate.model === MODEL &&
+    candidate.revision === REVISION &&
+    candidate.probabilityTolerance === TOLERANCE &&
+    tokenizer.revision === REVISION &&
+    typeof tokenizer.bosId === 'number' &&
+    Object.values(tokenizer.specialTokenIds).every((id) => typeof id === 'number') &&
+    Array.isArray(tokenizer.inputs) &&
+    tokenizer.inputs.every(isTokenizerInput) &&
+    Array.isArray(candidate.cases) &&
+    candidate.cases.every(isReferenceCase)
+  );
+}
+
+function requireReferenceCorpus(value: unknown): ReferenceCorpus {
+  if (!isReferenceCorpus(value)) throw new Error('pinned D1 reference corpus is malformed');
+  return value;
+}
+
+function makeTokenizer(corpus: ReferenceCorpus): D1Tokenizer {
+  const encodings = new Map(corpus.tokenizer.inputs.map(({ text, ids }) => [text, ids]));
+  return {
+    encode: (text) => {
+      const ids = encodings.get(text);
+      if (ids === undefined)
+        throw new Error(`missing pinned tokenizer input ${JSON.stringify(text)}`);
+      return [...ids];
+    },
+    tokenId: (token) => {
+      const id = corpus.tokenizer.specialTokenIds[token];
+      if (typeof id !== 'number') throw new Error(`missing D1 token ${token}`);
+      return id;
+    },
+    bosId: corpus.tokenizer.bosId,
+  };
+}
+
+function probabilities(answer: Answer, question: Question): number[] {
+  if (answer.type === 'noul') return [answer.noul, 1 - answer.noul];
+  if (answer.type === 'choice' && question.type === 'choice') {
+    return Object.keys(question.criteria).map((name) => answer.probabilities[name]!);
+  }
+  if (answer.type === 'score' && question.type === 'score') {
+    return question.criteria.map((_, index) => answer.probabilities[String(index)]!);
+  }
+  throw new Error(`D1 answer type did not match ${question.type}`);
+}
+
+function stableAnswer(answer: Answer, question: Question): string {
+  if (answer.type === 'noul') return answer.noul >= 0.5 ? 'yes' : 'no';
+  if (answer.type === 'choice') return answer.choice;
+  if (question.type !== 'score') throw new Error('score answer has a non-score question');
+  let best = 0;
+  for (let i = 1; i < question.criteria.length; i++) {
+    if (answer.probabilities[String(i)]! > answer.probabilities[String(best)]!) best = i;
+  }
+  return String(best);
+}
+
+function gpuBufferBytes(): number {
+  return [...liveBuffers()].reduce((sum, buffer) => sum + buffer.size, 0);
+}
+
+function cloneStateDict(sd: LazyStateDict, tensors: Map<string, LazyTensor>): LazyStateDict {
+  return {
+    metadata: sd.metadata,
+    tensors,
+    totalBytes: () => [...tensors.values()].reduce((sum, tensor) => sum + tensor.byteLength, 0),
+  };
+}
+
+function temperatures(corpus: ReferenceCorpus): Record<string, number> {
+  return Object.fromEntries(
+    corpus.cases.map((item) => [item.reference.temperatureKey, item.reference.temperature]),
+  );
+}
+
+async function hostMemory(): Promise<{ jsHeapBytes: number | null; agentBytes: number | null }> {
+  const memory = Reflect.get(performance, 'memory');
+  const jsHeapBytes =
+    typeof memory === 'object' &&
+    memory !== null &&
+    typeof Reflect.get(memory, 'usedJSHeapSize') === 'number'
+      ? Reflect.get(memory, 'usedJSHeapSize')
